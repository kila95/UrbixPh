import React, { useState, useEffect, useRef } from 'react';
import { 
  PhoneCall, PhoneOff, PhoneIncoming, Mic, MicOff, 
  DoorOpen, Search, Radio, Phone, ChevronDown, History, CheckCircle2 
} from 'lucide-react';
import { supabase, isSupabaseConfigured } from '../supabaseClient';

interface Props {
  modo: 'porteria' | 'residente';
  unidadResidente?: string;
  guardaNombre?: string;
  tenantId?: string;
  onAutorizarIngreso?: (visitante: string, unidad: string) => void;
  onShowToast?: (msg: string) => void;
}

const ICE_CONFIG: RTCConfiguration = {
  iceServers: [
    { urls: 'stun:stun.l.google.com:19302' },
    {
      urls: (import.meta as any).env?.VITE_TURN_URL || 'turn:openrelay.metered.ca:443?transport=tcp',
      username: (import.meta as any).env?.VITE_TURN_USERNAME || 'openrelayproject',
      credential: (import.meta as any).env?.VITE_TURN_CREDENTIAL || 'openrelayproject'
    }
  ]
};

export default function CitofoniaWebRTCPorteria({
  modo,
  unidadResidente = 'Torre 1 - 302',
  guardaNombre = 'Guarda en Turno',
  tenantId = 't1',
  onAutorizarIngreso,
  onShowToast
}: Props) {
  const [unidades, setUnidades] = useState<any[]>([]);
  const [busqueda, setBusqueda] = useState('');
  const [unidadSeleccionada, setUnidadSeleccionada] = useState('');
  const [nombreVisitante, setNombreVisitante] = useState('');
  
  const [motivoLlamadaGarita, setMotivoLlamadaGarita] = useState('Anuncio de Visitante o Familiar');
  const [mostrarMenuMotivos, setMostrarMenuMotivos] = useState(false);

  // Historial de llamadas del día
  const [historialLlamadas, setHistorialLlamadas] = useState<any[]>([]);

  // Estados de llamada de AUDIO
  const [estadoLlamada, setEstadoLlamada] = useState<'inactivo' | 'timbrando' | 'conectado'>('inactivo');
  const [llamadaEntrante, setLlamadaEntrante] = useState<any>(null);
  const [micActivo, setMicActivo] = useState(true);

  const peerIdRef = useRef<string>(`citofono_${modo}_${Date.now()}`);
  const pcRef = useRef<RTCPeerConnection | null>(null);
  const localStreamRef = useRef<MediaStream | null>(null);
  const audioElementRef = useRef<HTMLAudioElement | null>(null);

  // Cargar unidades reales y el historial del día desde Supabase
  const cargarDatosIniciales = async () => {
    try {
      if (modo === 'porteria') {
        const { data } = await supabase.from('units').select('*').limit(200);
        if (data && data.length > 0) {
          const mapeadas = data.map((u: any) => ({
            id: u.id,
            unit_number: u.unit_number || u.apartment_number || u.number || u.name || `Apto ${u.id.slice(0, 4)}`,
            owner_name: u.owner_name || u.resident_name || u.propietario || 'Propietario'
          }));
          setUnidades(mapeadas);
        }
      }

      // Cargar historial del día actual (filtra por fecha de hoy)
      const hoyISO = new Date().toISOString().split('T')[0];
      let query = supabase.from('citofono_logs').select('*').gte('created_at', `${hoyISO}T00:00:00`).order('created_at', { ascending: false });

      if (modo === 'residente') {
        query = query.eq('unit_number', unidadResidente);
      }

      const { data: logs } = await query;
      if (logs) setHistorialLlamadas(logs);
    } catch (e) {
      console.warn('Error cargando historial de citofonía:', e);
    }
  };

  useEffect(() => {
    cargarDatosIniciales();
  }, [modo, unidadResidente]);

  const registrarLogEnDB = async (unidad: string, visitante: string, motivo: string, estado: string) => {
    const nuevoLog = {
      tenant_id: tenantId,
      unit_number: unidad,
      visitor_name: visitante,
      call_reason: motivo,
      guard_name: guardaNombre,
      call_status: estado,
      created_at: new Date().toISOString()
    };

    // Actualizar vista local inmediata del día
    setHistorialLlamadas((prev) => [nuevoLog, ...prev]);

    if (isSupabaseConfigured) {
      try {
        await supabase.from('citofono_logs').insert([nuevoLog]);
      } catch (e) {
        console.warn('No se pudo persistir log en Supabase:', e);
      }
    }
  };

  const enviarSenal = async (event: string, payload: any) => {
    try {
      await fetch('/api/asamblea-signal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event, payload })
      });
    } catch (e) {
      console.error('Error en señalización:', e);
    }
  };

  useEffect(() => {
    const eventSource = new EventSource(`/api/asamblea-events?peerId=${peerIdRef.current}`);

    eventSource.onmessage = async (ev) => {
      try {
        const { event, payload } = JSON.parse(ev.data);

        if (event === 'solicitar_llamada' && modo === 'residente') {
          if (!unidadResidente || payload.unidadDestino === unidadResidente) {
            setLlamadaEntrante(payload);
            setEstadoLlamada('timbrando');
          }
        }

        if (event === 'webrtc_answer' && modo === 'porteria' && pcRef.current) {
          await pcRef.current.setRemoteDescription(new RTCSessionDescription(payload.answer));
          setEstadoLlamada('conectado');
          onShowToast?.(`Citófono conectado con ${payload.unidadDestino}`);
        }

        if (event === 'citofono_ice' && payload.sender !== peerIdRef.current && pcRef.current) {
          await pcRef.current.addIceCandidate(new RTCIceCandidate(payload.candidate));
        }

        if (event === 'citofono_puerta_autorizada' && modo === 'porteria') {
          onShowToast?.(`✅ PUERTA AUTORIZADA por ${payload.unidad} para ${payload.visitante}`);
          registrarLogEnDB(payload.unidad, payload.visitante, 'Acceso Autorizado', 'Autorizada');
          onAutorizarIngreso?.(payload.visitante, payload.unidad);
        }

        if (event === 'terminar_llamada') {
          limpiarConexionLocal();
        }
      } catch {}
    };

    return () => {
      eventSource.close();
      limpiarConexionLocal();
    };
  }, [modo, unidadResidente]);

  const inicializarPeerConnectionAudio = (stream: MediaStream) => {
    const pc = new RTCPeerConnection(ICE_CONFIG);
    stream.getTracks().forEach((track) => pc.addTrack(track, stream));

    pc.onicecandidate = (e) => {
      if (e.candidate) {
        enviarSenal('citofono_ice', {
          sender: peerIdRef.current,
          candidate: e.candidate
        });
      }
    };

    pc.ontrack = (e) => {
      if (e.streams[0]) {
        if (!audioElementRef.current) {
          audioElementRef.current = new Audio();
          audioElementRef.current.autoplay = true;
        }
        audioElementRef.current.srcObject = e.streams[0];
      }
    };

    pcRef.current = pc;
    return pc;
  };

  const ejecutarTimbrazoAudio = async (unidadDestino: string) => {
    if (!unidadDestino || !nombreVisitante.trim()) {
      alert('Selecciona un apartamento e ingresa el nombre de la visita.');
      return;
    }

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
      localStreamRef.current = stream;

      const pc = inicializarPeerConnectionAudio(stream);
      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);

      setEstadoLlamada('timbrando');
      await enviarSenal('solicitar_llamada', {
        offer,
        unidadDestino,
        visitante: nombreVisitante.trim(),
        motivo: motivoLlamadaGarita,
        guarda: guardaNombre,
        timestamp: Date.now()
      });

      registrarLogEnDB(unidadDestino, nombreVisitante.trim(), motivoLlamadaGarita, 'Completada');
      onShowToast?.(`Timbrando al citófono de ${unidadDestino}...`);
      setNombreVisitante('');
    } catch {
      alert('Permite el acceso al micrófono para usar el citófono.');
    }
  };

  const llamarAGaritaAudio = async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
      localStreamRef.current = stream;

      const pc = inicializarPeerConnectionAudio(stream);
      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);

      setEstadoLlamada('timbrando');
      await enviarSenal('solicitar_llamada', {
        offer,
        unidadDestino: 'GARITA_PORTERIA',
        visitante: `Residente ${unidadResidente}`,
        motivo: motivoLlamadaGarita,
        guarda: 'Garita Principal',
        timestamp: Date.now()
      });

      registrarLogEnDB(unidadResidente, 'Llamada a Garita', motivoLlamadaGarita, 'Completada');
      onShowToast?.('Llamando a la garita de vigilancia...');
    } catch {
      alert('Permite el acceso al micrófono para hablar con la garita.');
    }
  };

  const contestarLlamadaAudio = async () => {
    if (!llamadaEntrante?.offer) return;
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
      localStreamRef.current = stream;

      const pc = inicializarPeerConnectionAudio(stream);
      await pc.setRemoteDescription(new RTCSessionDescription(llamadaEntrante.offer));
      const answer = await pc.createAnswer();
      await pc.setLocalDescription(answer);

      await enviarSenal('webrtc_answer', {
        answer,
        unidadDestino: llamadaEntrante.unidadDestino
      });

      setEstadoLlamada('conectado');
    } catch {
      alert('No se pudo activar el micrófono.');
    }
  };

  const autorizarIngresoVisitante = async () => {
    if (!llamadaEntrante) return;
    await enviarSenal('citofono_puerta_autorizada', {
      unidad: llamadaEntrante.unidadDestino,
      visitante: llamadaEntrante.visitante
    });
    registrarLogEnDB(llamadaEntrante.unidadDestino, llamadaEntrante.visitante, 'Acceso Autorizado', 'Autorizada');
    onShowToast?.(`Ingreso autorizado en portería para ${llamadaEntrante.visitante}`);
    colgarLlamada();
  };

  const colgarLlamada = async () => {
    await enviarSenal('terminar_llamada', { peerId: peerIdRef.current });
    limpiarConexionLocal();
  };

  const limpiarConexionLocal = () => {
    localStreamRef.current?.getTracks().forEach((t) => t.stop());
    localStreamRef.current = null;
    if (audioElementRef.current) audioElementRef.current.srcObject = null;
    pcRef.current?.close();
    pcRef.current = null;
    setEstadoLlamada('inactivo');
    setLlamadaEntrante(null);
  };

  const toggleMic = () => {
    localStreamRef.current?.getAudioTracks().forEach((t) => (t.enabled = !micActivo));
    setMicActivo(!micActivo);
  };

  const unidadesFiltradas = unidades.filter(
    (u) =>
      u.unit_number?.toLowerCase().includes(busqueda.toLowerCase()) ||
      u.owner_name?.toLowerCase().includes(busqueda.toLowerCase())
  );

  return (
    <div className="bg-[#090d14] border-2 border-cyan-500/30 rounded-3xl p-5 text-slate-100 font-mono shadow-[0_0_30px_rgba(0,242,254,0.15)] space-y-5">
      
      {/* CABECERA */}
      <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-4">
        <div className="flex items-center gap-3">
          <div className="w-11 h-11 rounded-2xl bg-[#05131e] border border-[#00f2fe]/40 flex items-center justify-center text-[#00f2fe] shadow-[0_0_15px_rgba(0,242,254,0.3)]">
            <PhoneCall className="w-5 h-5" />
          </div>
          <div>
            <span className="text-[10px] uppercase tracking-widest px-2 py-0.5 rounded bg-cyan-500/10 text-[#00f2fe] border border-cyan-500/30 font-bold">
              CITOFONÍA VIRTUAL VOZ HD • SIN CABLEADO
            </span>
            <h3 className="text-base font-black text-white mt-1">
              {modo === 'porteria' ? 'Consola de Citofonía en Garita' : `Citófono Digital — ${unidadResidente}`}
            </h3>
          </div>
        </div>

        <div className="flex items-center gap-2 text-xs px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
          <Radio className="w-3.5 h-3.5 animate-pulse" />
          <span>Canal de Voz En Línea</span>
        </div>
      </div>

      {/* MODO PORTERÍA: LLAMAR DESDE GARITA */}
      {modo === 'porteria' && estadoLlamada === 'inactivo' && (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div className="space-y-3 bg-[#05080e] p-4 rounded-2xl border border-slate-800 flex flex-col justify-between">
            <div className="space-y-3">
              <label className="text-[11px] font-bold uppercase text-cyan-400 block">
                1. Seleccionar Inmueble Destino
              </label>
              <div className="relative">
                <Search className="w-4 h-4 text-slate-500 absolute left-3 top-2.5" />
                <input
                  type="text"
                  placeholder="Filtrar apartamento o residente..."
                  value={busqueda}
                  onChange={(e) => setBusqueda(e.target.value)}
                  className="w-full bg-[#090d14] border border-slate-700 rounded-xl pl-9 pr-3 py-2 text-xs text-white focus:border-[#00f2fe] outline-none"
                />
              </div>

              <select
                value={unidadSeleccionada}
                onChange={(e) => setUnidadSeleccionada(e.target.value)}
                className="w-full bg-[#090d14] border border-slate-700 rounded-xl p-2.5 text-xs text-white focus:border-[#00f2fe] outline-none"
              >
                <option value="">-- Selecciona el Apartamento ({unidadesFiltradas.length}) --</option>
                {unidadesFiltradas.map((u) => (
                  <option key={u.id} value={u.unit_number}>
                    {u.unit_number} — {u.owner_name || 'Propietario'}
                  </option>
                ))}
              </select>
            </div>

            <div className="p-3 bg-slate-900/60 rounded-xl border border-slate-800 text-[11px] text-slate-400">
              💡 Comunicación por voz bidireccional instantánea con el auricular del residente.
            </div>
          </div>

          <div className="space-y-3 bg-[#05080e] p-4 rounded-2xl border border-slate-800 flex flex-col justify-between">
            <div className="space-y-3">
              <label className="text-[11px] font-bold uppercase text-cyan-400 block">
                2. Datos de Visita en Portería
              </label>

              <input
                type="text"
                required
                placeholder="Nombre del visitante o empresa (Ej. Rappi / DHL)"
                value={nombreVisitante}
                onChange={(e) => setNombreVisitante(e.target.value)}
                className="w-full bg-[#090d14] border border-slate-700 rounded-xl p-2.5 text-xs text-white focus:border-[#00f2fe] outline-none"
              />

              <select
                value={motivoLlamadaGarita}
                onChange={(e) => setMotivoLlamadaGarita(e.target.value)}
                className="w-full bg-[#090d14] border border-slate-700 rounded-xl p-2.5 text-xs text-white outline-none"
              >
                <option>Visita Familiar / Personal</option>
                <option>Domicilio / Encomienda</option>
                <option>Servicio Técnico / Contratista</option>
                <option>Información General / Correspondencia</option>
              </select>
            </div>

            <button
              type="button"
              disabled={!unidadSeleccionada || !nombreVisitante.trim()}
              onClick={() => ejecutarTimbrazoAudio(unidadSeleccionada)}
              className="w-full mt-3 py-3 bg-gradient-to-r from-[#00f2fe] to-cyan-400 text-slate-950 font-black rounded-xl text-xs uppercase tracking-wider shadow-[0_0_20px_rgba(0,242,254,0.35)] hover:brightness-110 transition disabled:opacity-40 cursor-pointer flex items-center justify-center gap-2"
            >
              <PhoneCall className="w-4 h-4" />
              <span>Timbrar por Citófono</span>
            </button>
          </div>
        </div>
      )}

      {/* MODO RESIDENTE: LLAMAR A GARITA */}
      {modo === 'residente' && estadoLlamada === 'inactivo' && (
        <div className="p-5 bg-[#05080e] border border-slate-800 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span className="text-[10px] font-bold uppercase text-cyan-400 tracking-wider">
              Citófono Inmueble ⇄ Garita
            </span>
            <h4 className="text-sm font-bold text-white mt-0.5">
              Comunicación directa por voz con la portería
            </h4>
            <p className="text-xs text-slate-400 mt-1">
              Selecciona el motivo y presiona llamar para hablar directamente con el guarda.
            </p>
          </div>

          <div className="relative shrink-0 w-full sm:w-72">
            <button
              type="button"
              onClick={() => setMostrarMenuMotivos(!mostrarMenuMotivos)}
              className="w-full flex items-center justify-between gap-2 px-4 py-3 bg-gradient-to-r from-[#00f2fe] to-cyan-400 text-slate-950 font-black rounded-xl text-xs transition shadow-[0_0_20px_rgba(0,242,254,0.3)] cursor-pointer"
            >
              <div className="flex items-center gap-2 truncate">
                <PhoneCall className="w-4 h-4 shrink-0" />
                <span className="truncate">Llamar a Garita: {motivoLlamadaGarita}</span>
              </div>
              <ChevronDown className="w-4 h-4 shrink-0" />
            </button>

            {mostrarMenuMotivos && (
              <div className="absolute top-full left-0 right-0 mt-2 bg-[#05080e] border border-cyan-500/40 rounded-2xl shadow-2xl overflow-hidden z-20 font-sans">
                <div className="p-2 border-b border-slate-800 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                  Motivo de llamada:
                </div>
                {[
                  { label: '📦 Paquetería o Encomienda', val: 'Consulta de Paquetería' },
                  { label: '👥 Anuncio de Visitante / Familiar', val: 'Anuncio de Visitante o Familiar' },
                  { label: '⚠️ Emergencia o Novedad', val: 'Emergencia o Novedad en Inmueble' },
                  { label: 'ℹ️ Información General', val: 'Información General a Portería' }
                ].map((m) => (
                  <button
                    key={m.val}
                    type="button"
                    onClick={() => {
                      setMotivoLlamadaGarita(m.val);
                      setMostrarMenuMotivos(false);
                    }}
                    className={`w-full text-left px-3.5 py-2.5 text-xs transition cursor-pointer flex items-center gap-2 ${
                      motivoLlamadaGarita === m.val
                        ? 'bg-cyan-500/20 text-cyan-300 font-bold'
                        : 'text-slate-300 hover:bg-slate-800/80'
                    }`}
                  >
                    <span>{m.label}</span>
                  </button>
                ))}

                <div className="p-2 border-t border-slate-800 bg-[#030508]">
                  <button
                    type="button"
                    onClick={() => {
                      setMostrarMenuMotivos(false);
                      llamarAGaritaAudio();
                    }}
                    className="w-full py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl text-xs flex items-center justify-center gap-1.5 shadow-md cursor-pointer"
                  >
                    <PhoneCall className="w-3.5 h-3.5" />
                    <span>Conectar Llamada de Voz</span>
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* ALERTA DE LLAMADA ENTRANTE */}
      {modo === 'residente' && estadoLlamada === 'timbrando' && llamadaEntrante && (
        <div className="p-5 bg-[#05131e] border-2 border-[#00f2fe] rounded-2xl shadow-[0_0_30px_rgba(0,242,254,0.3)] flex flex-col sm:flex-row items-center justify-between gap-4 animate-pulse">
          <div className="flex items-center gap-3.5">
            <div className="p-3.5 rounded-2xl bg-[#00f2fe] text-slate-950">
              <PhoneIncoming className="w-6 h-6 animate-bounce" />
            </div>
            <div>
              <span className="text-[10px] font-bold uppercase text-[#00f2fe]">
                LLAMADA DE VOZ ENTRANTE ({llamadaEntrante.guarda})
              </span>
              <h4 className="text-base font-black text-white">
                Motivo: {llamadaEntrante.motivo}
              </h4>
              <p className="text-xs text-slate-300">Visitante: {llamadaEntrante.visitante}</p>
            </div>
          </div>

          <div className="flex items-center gap-2.5 w-full sm:w-auto">
            <button
              onClick={contestarLlamadaAudio}
              className="flex-1 sm:flex-initial px-4 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl text-xs flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <PhoneCall className="w-4 h-4" /> Contestar Llamada
            </button>
            <button
              onClick={colgarLlamada}
              className="px-3.5 py-2.5 bg-rose-600 hover:bg-rose-500 text-white font-bold rounded-xl text-xs flex items-center justify-center gap-1 cursor-pointer"
            >
              <PhoneOff className="w-4 h-4" /> Rechazar
            </button>
          </div>
        </div>
      )}

      {/* PANEL DE LLAMADA DE VOZ ACTIVA */}
      {(estadoLlamada === 'conectado' || estadoLlamada === 'timbrando') && (
        <div className="p-6 bg-[#05080e] border border-cyan-500/40 rounded-2xl text-center space-y-4">
          <div className="w-16 h-16 rounded-full bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-400 mx-auto animate-pulse">
            <PhoneCall className="w-8 h-8" />
          </div>

          <div>
            <h4 className="text-sm font-bold text-white">
              {estadoLlamada === 'timbrando' ? 'Estableciendo comunicación de voz...' : 'Llamada de Citófono en Curso'}
            </h4>
            <p className="text-xs text-cyan-400 font-mono mt-1">
              {modo === 'porteria' ? `Conectado con Inmueble ${unidadSeleccionada}` : 'Conectado con Garita de Vigilancia'}
            </p>
          </div>

          <div className="flex items-center justify-center gap-3 pt-2">
            <button
              type="button"
              onClick={toggleMic}
              className={`px-4 py-3 rounded-xl border text-xs font-bold cursor-pointer flex items-center gap-2 ${
                micActivo ? 'bg-slate-800 text-white border-slate-700' : 'bg-rose-500/20 text-rose-400 border-rose-500/40'
              }`}
            >
              {micActivo ? <Mic className="w-4 h-4" /> : <MicOff className="w-4 h-4" />}
              <span>{micActivo ? 'Silenciar Micrófono' : 'Micrófono Silenciado'}</span>
            </button>

            {modo === 'residente' && (
              <button
                type="button"
                onClick={autorizarIngresoVisitante}
                className="px-5 py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl text-xs flex items-center gap-2 shadow-[0_0_20px_rgba(16,185,129,0.4)] cursor-pointer"
              >
                <DoorOpen className="w-4 h-4" />
                <span>Autorizar Entrada en Portería</span>
              </button>
            )}

            <button
              type="button"
              onClick={colgarLlamada}
              className="px-5 py-3 bg-rose-600 hover:bg-rose-500 text-white font-black rounded-xl text-xs flex items-center gap-2 cursor-pointer"
            >
              <PhoneOff className="w-4 h-4" />
              <span>Colgar</span>
            </button>
          </div>
        </div>
      )}

      {/* ========================================================
          HISTORIAL DE LLAMADAS DEL DÍA (INALTERABLE PARA EL USUARIO)
         ======================================================== */}
      <div className="pt-3 border-t border-slate-800 space-y-3">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2 text-xs font-bold text-cyan-400 uppercase tracking-wider">
            <History className="w-4 h-4" />
            <span>Historial de Citofonía del Día ({historialLlamadas.length})</span>
          </div>
          <span className="text-[10px] text-slate-500 font-mono">
            * Se limpia automáticamente al iniciar nuevo día (Persistido en Supabase)
          </span>
        </div>

        <div className="bg-[#05080e] border border-slate-800 rounded-2xl p-3 max-h-48 overflow-y-auto space-y-2">
          {historialLlamadas.length === 0 ? (
            <div className="text-center py-6 text-slate-500 text-xs font-mono">
              No hay registros de llamadas en el citófono durante el día de hoy.
            </div>
          ) : (
            historialLlamadas.map((log, idx) => (
              <div key={idx} className="p-2.5 bg-[#090d14] border border-slate-800/80 rounded-xl flex items-center justify-between text-xs font-mono">
                <div className="space-y-0.5">
                  <div className="flex items-center gap-2">
                    <span className="font-bold text-cyan-300">{log.unit_number}</span>
                    <span className="text-slate-400">• {log.visitor_name}</span>
                    <span className="text-[10px] bg-slate-800 px-2 py-0.5 rounded text-slate-300">{log.call_reason}</span>
                  </div>
                  <div className="text-[10px] text-slate-500">
                    Atendido por: {log.guard_name || 'Guarda'} • {new Date(log.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                  </div>
                </div>

                <span className={`px-2 py-1 rounded text-[10px] font-bold ${
                  log.call_status === 'Autorizada' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20'
                }`}>
                  {log.call_status}
                </span>
              </div>
            ))
          )}
        </div>
      </div>

    </div>
  );
}