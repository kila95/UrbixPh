            </div>
            <div style={{ backgroundColor: '#1c1c1f', padding: '16px', borderRadius: '8px' }}>
              <span style={{ fontSize: '11px', color: '#94a3b8', fontFamily: 'monospace' }}>TIPO DE DECISIÓN / MAYORÍA</span>
              <select value={tipoMayoria} onChange={(e) => setTipoMayoria(e.target.value)} style={{ width: '100%', marginTop: '6px', backgroundColor: '#141416', color: '#fff', padding: '8px', borderRadius: '4px', border: '1px solid #262629' }}>
