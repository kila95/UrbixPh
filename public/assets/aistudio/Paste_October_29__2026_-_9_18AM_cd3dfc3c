          <div style={{ marginBottom: '20px', display: 'flex', justifyContent: 'flex-end' }}>
            <button onClick={() => { setShowAddModal(!showAddModal); setCreatedCredentials(null); }} style={{ backgroundColor: '#34d399', color: '#09090b', fontWeight: 'bold', fontSize: '12px', padding: '10px 16px', borderRadius: '8px', border: 'none', cursor: 'pointer' }}>
              {showAddModal ? "✕ Cerrar Formulario" : "+ Inscribir Copropiedad & Generar Login Admin"}
            </button>
          </div>

          {createdCredentials && (
            <div style={{ backgroundColor: 'rgba(52, 211, 153, 0.05)', border: '1px solid #34d399', borderRadius: '12px', padding: '20px', marginBottom: '24px' }}>
              <h4 style={{ margin: '0 0 8px 0', color: '#34d399', fontSize: '15px' }}>🎉 ¡Cliente Registrado y Factura DIAN Generada!</h4>
              <div style={{ backgroundColor: '#1c1c1f', padding: '12px', borderRadius: '6px', fontFamily: 'monospace', fontSize: '13px', color: '#fff' }}>
                <p style={{ margin: '0 0 4px 0' }}>👤 <strong>Nombre:</strong> {createdCredentials.name}</p>
                <p style={{ margin: '0 0 4px 0' }}>✉️ <strong>Login Admin:</strong> <span style={{ color: '#34d399' }}>{createdCredentials.email}</span></p>
                <p style={{ margin: 0 }}>🔑 <strong>Contraseña Temporal:</strong> <span style={{ color: '#f59e0b' }}>{createdCredentials.pass}</span></p>
              </div>
            </div>
          )}

          {showAddModal && (
            <div style={{ backgroundColor: '#141416', border: '1px solid #34d399', borderRadius: '12px', padding: '24px', marginBottom: '24px' }}>
              <h3 style={{ margin: '0 0 16px 0', fontSize: '16px', color: '#ffffff' }}>Alta de Nuevo Inquilino SaaS & Facturación DIAN</h3>
              <form onSubmit={handleRegisterClient} style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '16px' }}>
                <div>
                  <label style={{ fontSize: '11px', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>COPROPIEDAD *</label>
                  <input type="text" placeholder="Edificio Mirador" value={newClientName} onChange={(e) => setNewClientName(e.target.value)} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px' }} />
                </div>
                <div>
                  <label style={{ fontSize: '11px', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>ADMINISTRADOR *</label>
                  <input type="text" placeholder="Sofía Gómez" value={newAdminName} onChange={(e) => setNewAdminName(e.target.value)} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px' }} />
                </div>
                <div>
                  <label style={{ fontSize: '11px', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>CORREO LOGIN *</label>
                  <input type="email" placeholder="sofia@edificio.com" value={newAdminEmail} onChange={(e) => setNewAdminEmail(e.target.value)} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px' }} />
                </div>
                <div>
                  <label style={{ fontSize: '11px', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>PLAN</label>
                  <select value={newPlan} onChange={(e) => { setNewPlan(e.target.value); setNewAmount(e.target.value.includes('Enterprise') ? 450000 : 280000); }} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px' }}>
                    <option value="Plan Estándar">Plan Estándar (280k)</option>
                    <option value="Plan Enterprise">Plan Enterprise (450k)</option>
                  </select>
                </div>
                <div style={{ gridColumn: '1 / -1', display: 'flex', justifyContent: 'flex-end', gap: '12px' }}>
                  <button type="button" onClick={() => setShowAddModal(false)} style={{ background: 'transparent', color: '#94a3b8', border: '1px solid #262629', padding: '8px 16px', borderRadius: '6px', cursor: 'pointer' }}>Cancelar</button>
                  <button type="submit" style={{ backgroundColor: '#10b981', color: '#09090b', fontWeight: 'bold', border: 'none', padding: '8px 20px', borderRadius: '6px', cursor: 'pointer' }}>CREAR CLIENTE & FACTURA DIAN</button>
                </div>
              </form>
            </div>
          )}

          <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
            <h3 style={{ margin: '0 0 16px 0', fontSize: '16px', color: '#ffffff' }}>Suscripciones Activas y Estado DIAN</h3>
            <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: '14px' }}>
              <thead>
                <tr style={{ backgroundColor: '#1c1c1f', color: '#94a3b8', fontFamily: 'monospace', fontSize: '12px' }}>
                  <th style={{ padding: '12px' }}>Copropiedad</th>
                  <th style={{ padding: '12px' }}>Plan</th>
                  <th style={{ padding: '12px' }}>Valor</th>
                  <th style={{ padding: '12px' }}>Estatus DIAN</th>
                  <th style={{ padding: '12px', textAlign: 'right' }}>Estado</th>
                </tr>
              </thead>
              <tbody>
                {subscriptions.map(sub => (
                  <tr key={sub.id} style={{ borderBottom: '1px solid #262629' }}>
                    <td style={{ padding: '12px', fontWeight: '500', color: '#fff' }}>{sub.client}</td>
                    <td style={{ padding: '12px', color: '#94a3b8', fontFamily: 'monospace', fontSize: '12px' }}>{sub.plan}</td>
                    <td style={{ padding: '12px', fontFamily: 'monospace', color: '#34d399' }}>${sub.amount.toLocaleString()} COP</td>
                    <td style={{ padding: '12px', color: '#60a5fa', fontFamily: 'monospace', fontSize: '12px' }}>{sub.dianStatus}</td>
                    <td style={{ padding: '12px', textAlign: 'right' }}>
                      <span style={{ padding: '3px 8px', borderRadius: '4px', fontSize: '10px', fontFamily: 'monospace', fontWeight: 'bold', backgroundColor: 'rgba(52, 211, 153, 0.1)', color: '#34d399' }}>
                        {sub.status.toUpperCase()}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

    </div>
  );
}