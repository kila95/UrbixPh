import React, { useState, useEffect, useRef } from 'react';
import { 
  Video, Mic, MicOff, VideoOff, Disc, Square, Users, 
  Vote, MessageSquare, Hand, ShieldCheck, Percent, 
  Send, AlertCircle, RefreshCw, Download, PhoneOff, Radio
} from 'lucide-react';
import { supabase } from '../supabaseClient';
import MultiDayMeetingRecorder from '../MultiDayMeetingRecorder';
import ResilientMeetingRecorder from '../ResilientMeetingRecorder';

interface Props {
  tenantId?: string;
  userProfile?: {
    id?: string;
    full_name?: string;
    role?: string;
    unit_id?: string;
    unit_number?: string;
    coefficient?: number;
  };
  onShowToast?: (msg: string) => void;
}

// Configuración de Servidores ICE con tu TURN configurado en .env
const ICE_CONFIG = {
  iceServers: [
    { urls: 'stun:stun.l.google.com:19302' },
    {
      urls: import.meta.env.VITE_TURN_URL || 'turn:openrelay.metered.ca:443?transport=tcp',
      username: import.meta.env.VITE_TURN_USERNAME || 'openrelayproject',
      credential: import.meta.env.VITE_TURN_CREDENTIAL || 'openrelayproject'
    }
  ]
};

export default function SalaAsambleaVirtualReal({
  tenantId = 't1',
  userProfile = { full_name: 'Administrador PH', role: 'admin', unit_number: 'Administración', coefficient: 0 },
  onShowToast
}: Props) {
  const [panelLateral, setPanelLateral] = useState<'votaciones' | 'chat' | 'cuorum' | 'grabadora'>('votaciones');

  // Identificador único de este participante
  const peerIdRef = useRef<string>(`peer_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`);

  // WebRTC & Streams
  const [micActivo, setMicActivo] = useState(false);
  const [camaraActiva, setCamaraActiva] = useState(false);
  const [streamLocal, setStreamLocal] = useState<MediaStream | null>(null);
  const videoLocalRef = useRef<HTMLVideoElement>(null);
  const videoRemotoRef = useRef<HTMLVideoElement>(null);
  const peerConnectionRef = useRef<RTCPeerConnection | null>(null);

  // Participantes sincronizados por /api/asamblea-events
  const [participantes, setParticipantes] = useState<any[]>([]);
  const [cuorumTotal, setCuorumTotal] = useState<number>(0);
  const [convocatoriaActiva, setConvocatoriaActiva] = useState<any>(null);

  // Votaciones y Chat
  const [votaciones, setVotaciones] = useState<any[]>([]);
  const [nuevaPregunta, setNuevaPregunta] = useState('');
  const [opcionesInput, setOpcionesInput] = useState('A favor, En contra, En blanco');
  const [mensajesChat, setMensajesChat] = useState<any[]>([]);
  const [nuevoMensaje, setNuevoMensaje] = useState('');
  const [manoLevantada, setManoLevantada] = useState(false);

  // 1. Inicialización y Conexión con tu backend server.ts (/api/asamblea-events)
  useEffect(() => {
    const peerId = peerIdRef.current;

    // Conexión SSE al bus de eventos de tu server.ts
    const eventSource = new EventSource(`/api/asamblea-events?peerId=${peerId}`);

    eventSource.onmessage = async (e) => {
      try {
        const data = JSON.parse(e.data);
        const { event, payload } = data;

        if (event === 'asamblea_convocatoria_abierta') {
          setConvocatoriaActiva(payload);
        } else if (event === 'participante_listo') {
          setParticipantes((prev) => {
            const index = prev.findIndex(p => p.peerId === payload.peerId);
            if (index >= 0) {
              const copia = [...prev];
              copia[index] = payload;
              return copia;
            }
            return [...prev, payload];
          });
        } else if (event === 'asamblea_peer_salio') {
          setParticipantes((prev) => prev.filter(p => p.peerId !== payload.peerId));
        } else if (event === 'webrtc_offer' && payload.targetPeerId === peerId) {
          await manejarOfertaEntrante(payload);
        } else if (event === 'webrtc_answer' && payload.targetPeerId === peerId) {
          if (peerConnectionRef.current) {
            await peerConnectionRef.current.setRemoteDescription(new RTCSessionDescription(payload.answer));
          }
        } else if (event === 'ice_candidate' && payload.targetPeerId === peerId) {
          if (peerConnectionRef.current && payload.candidate) {
            await peerConnectionRef.current.addIceCandidate(new RTCIceCandidate(payload.candidate));
          }
        } else if (event === 'asamblea_chat_mensaje') {
          setMensajesChat((prev) => [...prev, payload]);
        }
      } catch (err) {
        // Ping de keep-alive u otros datos de control
      }
    };

    // Notificar presencia al servidor Express
    enviarSenal('participante_listo', {
      peerId,
      nombre: userProfile.full_name,
      unidad: userProfile.unit_number,
      role: userProfile.role,
      coefficient: userProfile.coefficient || 0,
      micActivo: false,
      camActiva: false
    });

    // Cargar cuórum inicial desde base de datos
    cargarCuorumBase();

    return () => {
      enviarSenal('asamblea_peer_salio', { peerId });
      eventSource.close();
      streamLocal?.getTracks().forEach(t => t.stop());
      peerConnectionRef.current?.close();
    };
  }, [tenantId]);

  // Calcular cuórum real ponderado de los asistentes
  useEffect(() => {
    const suma = participantes.reduce((acc, p) => acc + Number(p.coefficient || 0), 0);
    setCuorumTotal(Number(suma.toFixed(3)));
  }, [participantes]);

  // Cargar coeficiente de unidades desde Supabase para quórum fidedigno
  const cargarCuorumBase = async () => {
    const { data: units } = await supabase.from('units').select('id, coefficient');
    if (units && units.length > 0 && (!userProfile.coefficient || userProfile.coefficient === 0)) {
      // Si el usuario actual tiene unidad asignada, asociamos su coeficiente real
      const myUnit = units.find(u => u.id === userProfile.unit_id);
      if (myUnit) {
        userProfile.coefficient = Number(myUnit.coefficient);
      }
    }
  };

  // Función genérica para emitir señales al endpoint /api/asamblea-signal de tu server.ts
  const enviarSenal = async (event: string, payload: any) => {
    try {
      await fetch('/api/asamblea-signal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event, payload })
      });
    } catch (e) {
      console.error('Error enviando señal WebRTC:', e);
    }
  };

  // Inicializar PeerConnection nativo con servidores STUN/TURN
  const obtenerOIniciarPeerConnection = () => {
    if (peerConnectionRef.current) return peerConnectionRef.current;

    const pc = new RTCPeerConnection(ICE_CONFIG);

    pc.onicecandidate = (event) => {
      if (event.candidate) {
        enviarSenal('ice_candidate', {
          candidate: event.candidate,
          senderPeerId: peerIdRef.current,
          targetPeerId: participantes.find(p => p.peerId !== peerIdRef.current)?.peerId
        });
      }
    };

    pc.ontrack = (event) => {
      if (videoRemotoRef.current && event.streams[0]) {
        videoRemotoRef.current.srcObject = event.streams[0];
      }
    };

    if (streamLocal) {
      streamLocal.getTracks().forEach(t => pc.addTrack(t, streamLocal));
    }

    peerConnectionRef.current = pc;
    return pc;
  };

  // Negociación WebRTC Oferta / Respuesta
  const emitirOfertaWebRTC = async () => {
    const pc = obtenerOIniciarPeerConnection();
    const offer = await pc.createOffer();
    await pc.setLocalDescription(offer);

    enviarSenal('webrtc_offer', {
      offer,
      senderPeerId: peerIdRef.current,
      targetPeerId: participantes.find(p => p.peerId !== peerIdRef.current)?.peerId
    });
  };

  const manejarOfertaEntrante = async (payload: any) => {
    const pc = obtenerOIniciarPeerConnection();
    await pc.setRemoteDescription(new RTCSessionDescription(payload.offer));
    const answer = await pc.createAnswer();
    await pc.setLocalDescription(answer);

    enviarSenal('webrtc_answer', {
      answer,
      senderPeerId: peerIdRef.current,
      targetPeerId: payload.senderPeerId
    });
  };

  // Control Cámara
  const toggleCamara = async () => {
    if (camaraActiva) {
      streamLocal?.getVideoTracks().forEach(t => t.stop());
      setCamaraActiva(false);
      enviarSenal('asamblea_estado_media', { peerId: peerIdRef.current, camActiva: false });
    } else {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { width: { ideal: 1280 }, height: { ideal: 720 } },
          audio: micActivo
        });
        setStreamLocal(stream);
        if (videoLocalRef.current) videoLocalRef.current.srcObject = stream;
        setCamaraActiva(true);

        const pc = obtenerOIniciarPeerConnection();
        const vTrack = stream.getVideoTracks()[0];
        const sender = pc.getSenders().find(s => s.track?.kind === 'video');
        if (sender) {
          sender.replaceTrack(vTrack);
        } else {
          pc.addTrack(vTrack, stream);
        }
        await emitirOfertaWebRTC();
        enviarSenal('asamblea_estado_media', { peerId: peerIdRef.current, camActiva: true });
      } catch (err) {
        alert('No se pudo acceder a la cámara. Verifica los permisos.');
      }
    }
  };

  // Control Micrófono
  const toggleMic = async () => {
    if (micActivo) {
      streamLocal?.getAudioTracks().forEach(t => t.stop());
      setMicActivo(false);
      enviarSenal('asamblea_estado_media', { peerId: peerIdRef.current, micActivo: false });
    } else {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: true, noiseSuppression: true },
          video: camaraActiva
        });
        setStreamLocal(stream);
        setMicActivo(true);

        const pc = obtenerOIniciarPeerConnection();
        const aTrack = stream.getAudioTracks()[0];
        const sender = pc.getSenders().find(s => s.track?.kind === 'audio');
        if (sender) {
          sender.replaceTrack(aTrack);
        } else {
          pc.addTrack(aTrack, stream);
        }
        await emitirOfertaWebRTC();
        enviarSenal('asamblea_estado_media', { peerId: peerIdRef.current, micActivo: true });
      } catch (err) {
        alert('No se pudo acceder al micrófono. Verifica los permisos.');
      }
    }
  };

  // Enviar mensaje en vivo al bus del plenario
  const handleEnviarMensaje = (e: React.FormEvent) => {
    e.preventDefault();
    if (!nuevoMensaje.trim()) return;

    const msj = {
      id: Date.now().toString(),
      autor: userProfile.full_name,
      unidad: userProfile.unit_number,
      texto: nuevoMensaje.trim(),
      hora: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };

    enviarSenal('asamblea_chat_mensaje', msj);
    setMensajesChat(prev => [...prev, msj]);
    setNuevoMensaje('');
  };

  // Crear votación nominal
  const handleCrearVotacion = (e: React.FormEvent) => {
    e.preventDefault();
    if (!nuevaPregunta.trim()) return;

    const opciones = opcionesInput.split(',').map(o => o.trim()).filter(Boolean);
    const nueva = {
      id: Date.now().toString(),
      titulo: nuevaPregunta.trim(),
      opciones: opciones.map(opt => ({ texto: opt, votosCoeficiente: 0, conteo: 0 })),
      activa: true
    };

    setVotaciones(prev => [nueva, ...prev]);
    setNuevaPregunta('');
    onShowToast?.('Moción de votación sometida al plenario');
  };

  // Votar por coeficiente real
  const handleVotar = (votacionId: string, opcionIdx: number) => {
    const peso = userProfile.coefficient || 1.0;
    setVotaciones(prev => prev.map(v => {
      if (v.id !== votacionId || !v.activa) return v;
      const opts = v.opciones.map((o: any, idx: number) => {
        if (idx === opcionIdx) {
          return { ...o, votosCoeficiente: Number((o.votosCoeficiente + peso).toFixed(3)), conteo: o.conteo + 1 };
        }
        return o;
      });
      return { ...v, opciones: opts };
    }));
    onShowToast?.('Tu voto por coeficiente ha sido asentado');
  };

  const hayQuorumLegal = cuorumTotal >= 51.0;

  return (
    <div className="space-y-6 font-sans text-slate-100">
      
      {/* 1. CABECERA: QUÓRUM LEY 675 & ESTADO DE RED WEBRTC */}
      <div className="bg-[#0F172A] border border-slate-800 p-4 sm:p-5 rounded-2xl flex flex-wrap items-center justify-between gap-4 shadow-xl">
        <div className="flex flex-wrap items-center gap-4">
          <div>
            <div className="flex items-center gap-2">
              <span className="text-[10px] font-mono uppercase bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 px-2.5 py-0.5 rounded-full font-bold">
                LEY 675 DE 2001 • SESIÓN EN CURSO
              </span>
              <span className="text-xs text-slate-400 font-mono">Bus SSE & TURN Conectados</span>
            </div>
            <h2 className="text-lg font-bold text-white mt-0.5 flex items-center gap-2">
              <Video className="w-5 h-5 text-cyan-400" />
              Sala de Asamblea & Videoconferencia Parlamentaria
            </h2>
          </div>

          {/* Quórum Ponderado */}
          <div className="flex items-center gap-3 bg-[#1E293B] border border-slate-700/80 px-3.5 py-2 rounded-xl text-xs font-mono">
            <Percent className="w-4 h-4 text-cyan-400" />
            <div>
              <div className="flex items-center gap-2">
                <span className="text-slate-400">Cuórum Asistente:</span>
                <span className={`font-bold text-sm ${hayQuorumLegal ? 'text-emerald-400' : 'text-amber-400'}`}>
                  {cuorumTotal}%
                </span>
              </div>
              <p className="text-[10px] text-slate-400">
                {hayQuorumLegal ? 'Quórum Deliberatorio & Decisorio Válido' : 'Quórum Insuficiente (< 51%)'}
              </p>
            </div>
          </div>
        </div>

        <div className="flex items-center gap-2.5">
          <button
            onClick={() => setPanelLateral('grabadora')}
            className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold transition cursor-pointer border ${
              panelLateral === 'grabadora'
                ? 'bg-purple-500/20 text-purple-300 border-purple-500/40'
                : 'bg-slate-900 hover:bg-slate-800 text-slate-300 border-slate-700'
            }`}
          >
            <Disc className="w-4 h-4 text-purple-400" />
            <span>Motor Grabación 3h+ (IA)</span>
          </button>

          <button
            onClick={() => setManoLevantada(!manoLevantada)}
            className={`p-2.5 rounded-xl border transition cursor-pointer ${
              manoLevantada 
                ? 'bg-amber-500/20 text-amber-300 border-amber-500/40' 
                : 'bg-slate-900 hover:bg-slate-800 text-slate-400 border-slate-700'
            }`}
            title="Pedir la palabra"
          >
            <Hand className="w-4 h-4" />
          </button>
        </div>
      </div>

      {/* 2. ESCENARIO DE VIDEOLLAMADA REAL & CONTROLES */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        {/* ESCENARIO DE TRANSMISIÓN WEBRTC */}
        <div className="lg:col-span-2 space-y-4">
          <div className="bg-[#0F172A] border border-slate-800 rounded-2xl p-3 sm:p-4 shadow-xl flex flex-col justify-between h-[480px] relative overflow-hidden">
            
            <div className="flex-1 rounded-xl bg-[#090D16] border border-slate-800/80 flex items-center justify-center relative overflow-hidden">
              {/* Video Local */}
              <video 
                ref={videoLocalRef} 
                autoPlay 
                playsInline 
                muted 
                className={`w-full h-full object-cover rounded-xl ${camaraActiva ? 'block' : 'hidden'}`}
              />

              {/* Video Remoto en Esquina */}
              <video 
                ref={videoRemotoRef} 
                autoPlay 
                playsInline 
                className="absolute bottom-3 right-3 w-44 h-32 object-cover rounded-xl border border-slate-700 shadow-2xl bg-slate-900"
              />

              {!camaraActiva && (
                <div className="text-center space-y-2">
                  <div className="w-16 h-16 rounded-full bg-[#1E293B] border border-slate-700 flex items-center justify-center text-slate-400 mx-auto">
                    <Video className="w-7 h-7" />
                  </div>
                  <h4 className="text-xs font-semibold text-slate-300">Cámara local inactiva</h4>
                  <p className="text-[11px] font-mono text-slate-500">Haz clic en el botón de cámara inferior para transmitir</p>
                </div>
              )}

              {/* Insignia de Orador en pantalla */}
              <div className="absolute top-3 left-3 bg-[#0F172A]/90 backdrop-blur-sm border border-slate-700 px-3 py-1 rounded-lg text-xs font-mono text-slate-200 flex items-center gap-2">
                <span className="w-2 h-2 rounded-full bg-emerald-400" />
                <span>{userProfile.full_name}</span>
                <span className="text-[10px] text-cyan-400 uppercase font-bold">({userProfile.unit_number})</span>
              </div>
            </div>

            {/* Controles de Llamada */}
            <div className="pt-3 flex items-center justify-center gap-3">
              <button
                onClick={toggleMic}
                className={`p-3 rounded-xl border transition cursor-pointer ${
                  micActivo 
                    ? 'bg-slate-800 text-white border-slate-700' 
                    : 'bg-rose-500/10 text-rose-400 border-rose-500/30'
                }`}
                title={micActivo ? 'Silenciar' : 'Activar Micrófono'}
              >
                {micActivo ? <Mic className="w-5 h-5" /> : <MicOff className="w-5 h-5" />}
              </button>

              <button
                onClick={toggleCamara}
                className={`p-3 rounded-xl border transition cursor-pointer ${
                  camaraActiva 
                    ? 'bg-slate-800 text-white border-slate-700' 
                    : 'bg-rose-500/10 text-rose-400 border-rose-500/30'
                }`}
                title={camaraActiva ? 'Apagar Cámara' : 'Encender Cámara'}
              >
                {camaraActiva ? <Video className="w-5 h-5" /> : <VideoOff className="w-5 h-5" />}
              </button>

              <div className="h-6 w-px bg-slate-800 mx-2" />

              <span className="text-xs font-mono text-slate-400 flex items-center gap-1.5">
                <Radio className="w-3.5 h-3.5 text-cyan-400 animate-pulse" />
                {participantes.length} Participantes Sincronizados en Tiempo Real
              </span>
            </div>

          </div>
        </div>

        {/* PANEL LATERAL: VOTACIONES | CHAT | CUÓRUM | GRABADORA IA */}
        <div className="space-y-4">
          <div className="bg-[#0F172A] border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col h-[480px]">
            
            {/* Selector de Pestañas */}
            <div className="flex items-center gap-1 bg-[#1E293B] p-1 rounded-xl mb-4 border border-slate-700/80">
              <button
                onClick={() => setPanelLateral('votaciones')}
                className={`flex-1 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer flex items-center justify-center gap-1.5 ${
                  panelLateral === 'votaciones' 
                    ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' 
                    : 'text-slate-400 hover:text-white'
                }`}
              >
                <Vote className="w-3.5 h-3.5" />
                <span>Votación</span>
              </button>

              <button
                onClick={() => setPanelLateral('chat')}
                className={`flex-1 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer flex items-center justify-center gap-1.5 ${
                  panelLateral === 'chat' 
                    ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' 
                    : 'text-slate-400 hover:text-white'
                }`}
              >
                <MessageSquare className="w-3.5 h-3.5" />
                <span>Chat</span>
              </button>

              <button
                onClick={() => setPanelLateral('cuorum')}
                className={`flex-1 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer flex items-center justify-center gap-1.5 ${
                  panelLateral === 'cuorum' 
                    ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' 
                    : 'text-slate-400 hover:text-white'
                }`}
              >
                <Users className="w-3.5 h-3.5" />
                <span>Padrón</span>
              </button>
            </div>

            {/* TAB 1: VOTACIONES EN TIEMPO REAL */}
            {panelLateral === 'votaciones' && (
              <div className="flex-1 overflow-y-auto space-y-4 pr-1">
                {userProfile.role === 'admin' && (
                  <form onSubmit={handleCrearVotacion} className="p-3 bg-[#1E293B] border border-slate-700/80 rounded-xl space-y-2">
                    <span className="text-[10px] font-mono text-cyan-400 font-bold uppercase block">
                      Abrir Moción de Votación
                    </span>
                    <input
                      type="text"
                      required
                      placeholder="Ej. Aprobación del Presupuesto 2026"
                      value={nuevaPregunta}
                      onChange={(e) => setNuevaPregunta(e.target.value)}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500 font-sans"
                    />
                    <input
                      type="text"
                      placeholder="Opciones (A favor, En contra, En blanco)"
                      value={opcionesInput}
                      onChange={(e) => setOpcionesInput(e.target.value)}
                      className="w-full bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-[11px] text-white placeholder-slate-500 focus:outline-none font-sans"
                    />
                    <button
                      type="submit"
                      className="w-full py-1.5 bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 font-bold text-xs rounded-lg cursor-pointer"
                    >
                      Lanzar Votación
                    </button>
                  </form>
                )}

                {votaciones.length === 0 ? (
                  <div className="text-center py-10 bg-slate-950/40 rounded-xl border border-dashed border-slate-800 text-slate-500 text-xs font-mono">
                    No hay votaciones registradas en esta asamblea.
                  </div>
                ) : (
                  votaciones.map((v) => (
                    <div key={v.id} className="p-3 bg-[#1E293B] border border-slate-700/80 rounded-xl space-y-2.5">
                      <div className="flex justify-between items-start">
                        <h5 className="font-bold text-white text-xs">{v.titulo}</h5>
                        <span className="text-[9px] font-mono px-2 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300">
                          ABIERTA
                        </span>
                      </div>

                      <div className="space-y-1.5">
                        {v.opciones.map((opt: any, idx: number) => (
                          <div key={idx} className="space-y-1 text-[11px] font-mono">
                            <div className="flex justify-between text-slate-300">
                              <span>{opt.texto}</span>
                              <span className="text-cyan-400 font-bold">{opt.votosCoeficiente}% ({opt.conteo})</span>
                            </div>
                            <button
                              onClick={() => handleVotar(v.id, idx)}
                              className="w-full py-1 bg-slate-900 hover:bg-slate-800 border border-slate-700 rounded text-slate-300 cursor-pointer transition text-[10px]"
                            >
                              Votar por: {opt.texto}
                            </button>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))
                )}
              </div>
            )}

            {/* TAB 2: CHAT PARLAMENTARIO */}
            {panelLateral === 'chat' && (
              <div className="flex-1 flex flex-col justify-between overflow-hidden">
                <div className="flex-1 overflow-y-auto space-y-2 pr-1">
                  {mensajesChat.length === 0 ? (
                    <div className="text-center py-12 text-slate-500 text-xs font-mono">
                      No hay intervenciones escritas en el plenario.
                    </div>
                  ) : (
                    mensajesChat.map((m, idx) => (
                      <div key={idx} className="p-2.5 bg-slate-900/80 rounded-xl border border-slate-800 text-xs space-y-0.5">
                        <div className="flex justify-between items-center text-[10px] font-mono">
                          <span className="font-bold text-cyan-400">{m.autor} ({m.unidad})</span>
                          <span className="text-slate-500">{m.hora}</span>
                        </div>
                        <p className="text-slate-200">{m.texto}</p>
                      </div>
                    ))
                  )}
                </div>

                <form onSubmit={handleEnviarMensaje} className="pt-2 flex gap-1.5">
                  <input
                    type="text"
                    placeholder="Escribir al plenario..."
                    value={nuevoMensaje}
                    onChange={(e) => setNuevoMensaje(e.target.value)}
                    className="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none"
                  />
                  <button type="submit" className="p-2 bg-cyan-500 text-slate-950 rounded-xl cursor-pointer">
                    <Send className="w-3.5 h-3.5" />
                  </button>
                </form>
              </div>
            )}

            {/* TAB 3: CUÓRUM Y PARTICIPANTES CONECTADOS */}
            {panelLateral === 'cuorum' && (
              <div className="flex-1 overflow-y-auto space-y-2 pr-1 text-xs">
                <div className="p-3 bg-slate-900/80 rounded-xl border border-slate-800 space-y-1 font-mono text-[11px]">
                  <div className="flex justify-between">
                    <span className="text-slate-400">Total Conectados:</span>
                    <span className="text-white font-bold">{participantes.length} Propietarios</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Cuórum Representado:</span>
                    <span className="text-emerald-400 font-bold">{cuorumTotal.toFixed(3)}%</span>
                  </div>
                </div>

                <div className="space-y-1 pt-1">
                  {participantes.map((p, idx) => (
                    <div key={idx} className="p-2 bg-slate-900 rounded-lg flex items-center justify-between text-xs">
                      <div>
                        <span className="font-bold text-white">{p.nombre}</span>
                        <p className="text-[10px] font-mono text-cyan-400">{p.unidad}</p>
                      </div>
                      <span className="text-[10px] font-mono text-emerald-400 font-bold">
                        {Number(p.coefficient || 0).toFixed(3)}%
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* TAB 4: GRABADORA MULTI-DÍA RESILIENTE DE AUDIO (IA) */}
            {panelLateral === 'grabadora' && (
              <div className="flex-1 overflow-y-auto space-y-3 pr-1 text-xs">
                <p className="text-[11px] text-slate-400 leading-relaxed">
                  Motor de captura continua para actas de asamblea extensas con indexación en la boveda digital.
                </p>
                <MultiDayMeetingRecorder
                  tenantId={tenantId}
                  tenantName="Copropiedad"
                  onShowToast={onShowToast}
                />
              </div>
            )}

          </div>
        </div>

      </div>

    </div>
  );
}