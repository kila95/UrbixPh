interface ModulosOperativosProps {
  vistaModo?: 'porteria' | 'servicios_generales' | string;
  onCambiarVista?: (vista: any) => void;
  unidades?: any[];
  personal?: any[];
  ordenes?: any[];
  appendAuditLog?: (action: string, details: string, executor?: string) => void;
  auditLogs?: any[];
  celdasParqueadero?: CeldaParqueaderoPH[];
  setCeldasParqueadero?: React.Dispatch<React.SetStateAction<CeldaParqueaderoPH[]>>;
  registrosContratistasPuerta?: RegistroAccesoContratistaPuertaPH[];
  setRegistrosContratistasPuerta?: React.Dispatch<React.SetStateAction<RegistroAccesoContratistaPuertaPH[]>>;
  historialParqueadero?: HistorialParqueaderoMovimientoPH[];
  setHistorialParqueadero?: React.Dispatch<React.SetStateAction<HistorialParqueaderoMovimientoPH[]>>;
  contratistasSgsst?: ContratistaSgsstPorteriaPH[];
  onValidarQrContratistaPorteria?: (contratistaId: string) => void;
  visitasQr?: VisitaQrPH[];
  visitasQrShared?: VisitaQrPH[];
  setVisitasQrShared?: React.Dispatch<React.SetStateAction<VisitaQrPH[]>>;
  onActualizarEstadoVisitaQr?: (
    visitaId: string,
    nuevoEstado: 'Autorizado' | 'Adentro' | 'Salió' | 'Rechazado',
    celdaAsignada?: string
  ) => void;
  encomiendas?: EncomiendaPH[];
  encomiendasShared?: EncomiendaPH[];
  setEncomiendasShared?: React.Dispatch<React.SetStateAction<EncomiendaPH[]>>;
  onRegistrarEncomienda?: (nuevaEncomienda: {
    guia: string;
    empresa: string;
    unidad: string;
    destinatario: string;
    casillero: string;
  }) => void;
  onEntregarEncomienda?: (encomiendaId: string, pinIngresado?: string) => boolean;
  onShowToast?: (msg: string) => void;
}

export default function ModulosOperativosServiciosGenerales({
  vistaModo = 'porteria',
  celdasParqueadero = INITIAL_CELDAS_PARQUEADERO,
  setCeldasParqueadero,
  contratistasSgsst = [],
  onValidarQrContratistaPorteria,
  visitasQrShared = [],
  setVisitasQrShared,
  onActualizarEstadoVisitaQr,
  encomiendasShared = [],
  setEncomiendasShared,
  onRegistrarEncomienda,
  onEntregarEncomienda,
  appendAuditLog,
  onShowToast
}: ModulosOperativosProps) {
  // ==========================================================================
  // 2. ESTADOS OPERATIVOS DE LA CONSOLA DE VIGILANCIA
  // ==========================================================================
  const [codigoBusqueda, setCodigoBusqueda] = useState('');
  const [resultadoEscaneo, setResultadoEscaneo] = useState<{
    tipo: 'VISITA' | 'CONTRATISTA' | 'NO_ENCONTRADO';
    data?: any;
    query?: string;
  } | null>(null);

  // Estados de Encomiendas y Correo
  const [unidadPaquete, setUnidadPaquete] = useState('Torre 2 - 301');
  const [destinatarioPaquete, setDestinatarioPaquete] = useState('Esteban Ochoa Mesa');
  const [empresaPaquete, setEmpresaPaquete] = useState('MercadoLibre Full');
  const [guiaPaquete, setGuiaPaquete] = useState('');
  const [casilleroPaquete, setCasilleroPaquete] = useState('Casillero #12');
  const [pinValidacionMap, setPinValidacionMap] = useState<Record<string, string>>({});

  // Estados del Módulo de Rondas de Vigilancia
  const [puntosRonda, setPuntosRonda] = useState<PuntoRondaVigilanciaPH[]>(INITIAL_PUNTOS_RONDA);
  const [puntoSeleccionadoId, setPuntoSeleccionadoId] = useState<string>('chk_03');
  const [estadoRondaInput, setEstadoRondaInput] = useState<'Verificado OK' | 'Novedad Reportada'>('Verificado OK');
  const [observacionRondaInput, setObservacionRondaInput] = useState('');

  // ==========================================================================
  // 3. MANEJADORES CONECTADOS EN TIEMPO REAL CON APP.TSX
  // ==========================================================================

  // A. Escáner Criptográfico Unificado (Residentes + Contratistas SG-SST)
  const handleValidarQrEnVivo = (e: React.FormEvent) => {
    e.preventDefault();
    const query = codigoBusqueda.trim().toUpperCase();
    if (!query) return;

    const visita = visitasQrShared.find(
      v =>
        (v.codigoQr && v.codigoQr.toUpperCase() === query) ||
        (v.codigo && v.codigo.toUpperCase() === query) ||
        (v.pin && v.pin.toUpperCase() === query)
    );

    if (visita) {
      setResultadoEscaneo({ tipo: 'VISITA', data: visita });
      onShowToast?.(`Pase QR de residente (${visita.codigoQr || visita.codigo}) validado.`);
      return;
    }

    const contratista = contratistasSgsst.find(
      c => c.codigoQr && c.codigoQr.toUpperCase() === query
    );

    if (contratista) {
      setResultadoEscaneo({ tipo: 'CONTRATISTA', data: contratista });
      onShowToast?.(`QR institucional de contratista (${contratista.empresa}) verificado.`);
      return;
    }

    setResultadoEscaneo({ tipo: 'NO_ENCONTRADO', query });
    onShowToast?.(`Código "${query}" no encontrado o sin autorización activa.`);
  };

  // B. Botón de Ingreso / Salida / Reinicio de Visitas de Residentes
  const handleAccionVisita = (visita: VisitaQrPH) => {
    const siguienteEstado: 'Autorizado' | 'Adentro' | 'Salió' =
      visita.estado === 'Autorizado'
        ? 'Adentro'
        : visita.estado === 'Adentro'
        ? 'Salió'
        : 'Autorizado';

    // 1. Llamar al manejador oficial de App.tsx si está presente
    if (onActualizarEstadoVisitaQr) {
      onActualizarEstadoVisitaQr(visita.id, siguienteEstado, visita.celdaParqueadero || 'V-04');
      return;
    }

    // 2. Respaldo directo sobre setVisitasQrShared
    if (setVisitasQrShared) {
      const horaActual = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      setVisitasQrShared(prev =>
        prev.map(v =>
          v.id === visita.id
            ? {
                ...v,
                estado: siguienteEstado,
                ...(siguienteEstado === 'Adentro' ? { horaIngreso: horaActual } : {}),
                ...(siguienteEstado === 'Salió' ? { horaSalida: horaActual } : {})
              }
            : v
        )
      );
      onShowToast?.(`Visita de ${visita.nombreVisitante || visita.visitante} pasó a estado: ${siguienteEstado}`);
    }
  };

  // C. Registro de Nueva Encomienda en Portería
  const handleSubmitEncomienda = (e: React.FormEvent) => {
    e.preventDefault();
    if (!unidadPaquete.trim() || !destinatarioPaquete.trim()) return;

    if (onRegistrarEncomienda) {
      onRegistrarEncomienda({
        guia: guiaPaquete.trim() || `GUIA-${Math.floor(10000 + Math.random() * 90000)}`,
        empresa: empresaPaquete,
        unidad: unidadPaquete.trim(),
        destinatario: destinatarioPaquete.trim(),
        casillero: casilleroPaquete
      });
    } else if (setEncomiendasShared) {
      const nuevoPin = `PIN-${Math.floor(1000 + Math.random() * 9000)}`;
      const nueva: EncomiendaPH = {
        id: `enc_${Date.now()}`,
        guia: guiaPaquete.trim() || `GUIA-${Math.floor(10000 + Math.random() * 90000)}`,
        empresa: empresaPaquete,
        unidad: unidadPaquete.trim(),
        destinatario: destinatarioPaquete.trim(),
        casillero: casilleroPaquete,
        pinRetiro: nuevoPin,
        fechaLlegada: `Hoy ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`,
        horasCustodia: 0,
        estado: 'En Custodia',
        guardaReceptor: 'Guarda en Turno (Portería)'
      };
      setEncomiendasShared(prev => [nueva, ...prev]);
      onShowToast?.(`Encomienda registrada con PIN ${nuevoPin}`);
    }
    setGuiaPaquete('');
  };

  // D. Entrega de Encomienda al Residente
  const handleEntregarPaquetePorteria = (pkg: EncomiendaPH) => {
    const pinDigitado = pinValidacionMap[pkg.id]?.trim();
    if (onEntregarEncomienda) {
      onEntregarEncomienda(pkg.id, pinDigitado || pkg.pinRetiro);
      return;
    }
    if (setEncomiendasShared) {
      const hora = `Hoy ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
      setEncomiendasShared(prev =>
        prev.map(e => (e.id === pkg.id ? { ...e, estado: 'Entregado', fechaEntrega: hora } : e))
      );
      onShowToast?.(`Paquete ${pkg.guia} entregado a ${pkg.destinatario}.`);
    }
  };

  // E. Registro de Checkpoint en Módulo de Rondas de Vigilancia
  const handleRegistrarCheckpointRonda = (e: React.FormEvent) => {
    e.preventDefault();
    const hora = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const puntoTarget = puntosRonda.find(p => p.id === puntoSeleccionadoId);
    if (!puntoTarget) return;

    const detalleObs =
      observacionRondaInput.trim() ||
      (estadoRondaInput === 'Verificado OK'
        ? 'Ronda perimetral sin novedades. Equipos y cerramientos en orden.'
        : 'Novedad detectada en ronda. Notificado a Supervisión y Administración.');

    setPuntosRonda(prev =>
      prev.map(p =>
        p.id === puntoSeleccionadoId
          ? {
              ...p,
              estadoUltimoChequeo: estadoRondaInput,
              ultimaHora: hora,
              guarda: 'Guarda Carlos Restrepo (En Turno)',
              observacion: detalleObs
            }
          : p
      )
    );

    appendAuditLog?.(
      'GUARD_PATROL_CHECKPOINT',
      `Vigilancia completó checkpoint [${puntoTarget.codigoNfcQr}] en ${puntoTarget.nombrePunto} -> Estado: ${estadoRondaInput} (${detalleObs})`,
      'Vigilancia Portería'
    );

    setObservacionRondaInput('');
    onShowToast?.(`Checkpoint "${puntoTarget.nombrePunto}" registrado a las ${hora}.`);
  };

  const handleMarcarRondaDirecta = (id: string, nuevoEstado: 'Verificado OK' | 'Novedad Reportada') => {
    const hora = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    setPuntosRonda(prev =>
      prev.map(p =>
        p.id === id
          ? {
              ...p,
              estadoUltimoChequeo: nuevoEstado,
              ultimaHora: hora,
              observacion:
                nuevoEstado === 'Verificado OK'
                  ? 'Chequeo NFC en sitio validado sin novedades.'
                  : 'Requiere revisión de Todero / Mantenimiento.'
            }
          : p
      )
    );
    onShowToast?.(`Punto de ronda actualizado a [${nuevoEstado}] (${hora}).`);
  };

  const visitantesAdentroCount = visitasQrShared.filter(v => v.estado === 'Adentro').length;
  const paquetesEnCustodiaCount = encomiendasShared.filter(e => e.estado === 'En Custodia').length;
  const rondasVerificadasCount = puntosRonda.filter(r => r.estadoUltimoChequeo === 'Verificado OK').length;

  // ==========================================================================
  // 4. INTERFAZ VISUAL ENTERPRISE DE VIGILANCIA (ORDEN LÓGICO DE CONSTRUCCIÓN)
  // ==========================================================================
  return (
    <div className="space-y-6 font-sans text-slate-100 max-w-7xl mx-auto">
      
      {/* =====================================================================
          BLOQUE 1: CONSOLA CENTRAL UNIFICADA DE ACCESOS QR (RESIDENTES & SG-SST)
         ===================================================================== */}
      <div className="bg-slate-900 border border-slate-800 p-6 rounded-3xl shadow-2xl space-y-6">
        
        {/* Cabecera Operativa */}
        <div className="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 border-b border-slate-800 pb-4">
          <div className="flex items-center gap-3">
            <div className="p-3 bg-cyan-500/10 text-cyan-400 rounded-2xl border border-cyan-500/30 shadow-[0_0_15px_rgba(34,211,238,0.2)]">
              <QrCode className="w-6 h-6" />
            </div>
            <div>
              <span className="text-[10px] font-mono font-bold text-cyan-400 bg-cyan-500/10 px-2.5 py-0.5 rounded border border-cyan-500/20 uppercase tracking-widest">
                Módulo Unificado de Vigilancia • Escáner QR &amp; SG-SST
              </span>
              <h2 className="text-xl font-black text-white mt-1">
                Consola de Control de Accesos, Encomiendas y Rondas en Vivo
              </h2>
            </div>
          </div>

          <div className="flex flex-wrap items-center gap-2.5">
            <span className="px-3 py-1.5 rounded-xl bg-slate-950 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-bold flex items-center gap-1.5">
              <ShieldCheck className="w-4 h-4" /> Escudo Solidario SG-SST Activo
            </span>
            <span className="px-3 py-1.5 rounded-xl bg-slate-950 border border-cyan-500/30 text-cyan-400 text-xs font-mono font-bold">
              ⚡ {visitantesAdentroCount} Visitantes Adentro
            </span>
          </div>
        </div>

        {/* Lector Criptográfico QR (Con chips rápidos de prueba) */}
        <div className="bg-slate-950 border border-slate-800 p-5 rounded-2xl space-y-3">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h3 className="text-sm font-black text-white flex items-center gap-2">
                <QrCode className="w-4 h-4 text-cyan-400" /> Lector Criptográfico QR (Visitantes Residentes &amp; Contratistas)
              </h3>
              <p className="text-xs text-slate-400">
                Escanea o selecciona un código QR/PIN para validar en tiempo real el ingreso de visitas o verificar pólizas SG-SST.
              </p>
            </div>
          </div>

          {/* Botones rápidos de prueba en garita */}
          <div className="flex flex-wrap gap-2 pt-1">
            {visitasQrShared.slice(0, 3).map(v => (
              <button
                key={v.id}
                type="button"
                onClick={() => setCodigoBusqueda(v.codigoQr || v.codigo || '')}
                className="px-2.5 py-1 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/30 text-cyan-300 font-mono text-[11px] font-bold transition cursor-pointer"
              >
                Probar Visita: {v.codigoQr || v.codigo}
              </button>
            ))}
            {contratistasSgsst.map(c => (
              <button
                key={c.id}
                type="button"
                onClick={() => setCodigoBusqueda(c.codigoQr)}
                className="px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-300 font-mono text-[11px] transition cursor-pointer"
              >
                Contratista: {c.codigoQr}
              </button>
            ))}
          </div>

          <form onSubmit={handleValidarQrEnVivo} className="flex flex-col sm:flex-row gap-3 pt-1">
            <input
              type="text"
              value={codigoBusqueda}
              onChange={(e) => setCodigoBusqueda(e.target.value)}
              placeholder="Escanee o digite el código QR o PIN (ej: QR-8492 o QR-SST-9014-ASCENSORES)..."
              className="flex-1 p-3.5 bg-slate-900 border border-slate-700 text-white rounded-xl text-xs font-mono outline-none focus:border-cyan-400"
            />
            <button
              type="submit"
              className="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black px-6 py-3.5 rounded-xl text-xs transition cursor-pointer shadow-lg shadow-cyan-500/20 flex items-center justify-center gap-2 shrink-0"
            >
              <QrCode className="w-4 h-4" /> Validar Acceso en Vivo
            </button>
          </form>

          {/* Resultado instantáneo del escáner */}
          {resultadoEscaneo && (
            <div className="p-4 bg-slate-900 border border-cyan-500/40 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              {resultadoEscaneo.tipo === 'VISITA' && (
                <>
                  <div className="space-y-1">
                    <div className="flex items-center gap-2">
                      <span className="font-mono text-xs font-black text-cyan-400 bg-slate-950 px-2 py-0.5 rounded border border-cyan-500/30">
                        {resultadoEscaneo.data.codigoQr || resultadoEscaneo.data.codigo}
                      </span>
                      <span className="font-bold text-white text-sm">
                        {resultadoEscaneo.data.nombreVisitante || resultadoEscaneo.data.visitante}
                      </span>
                      <span className="text-[11px] bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded font-bold">
                        Estado: {resultadoEscaneo.data.estado}
                      </span>
                    </div>
                    <p className="text-xs text-slate-300">
                      Unidad Destino: <strong>{resultadoEscaneo.data.unidad}</strong> • Placa: {resultadoEscaneo.data.placaVehiculo || resultadoEscaneo.data.placa || 'Peatonal'}
                    </p>
                  </div>
                  <button
                    type="button"
                    onClick={() => handleAccionVisita(resultadoEscaneo.data)}
                    className="px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl text-xs cursor-pointer"
                  >
                    {resultadoEscaneo.data.estado === 'Autorizado' ? 'Dar Ingreso Ahora' : 'Registrar Salida'}
                  </button>
                </>
              )}

              {resultadoEscaneo.tipo === 'CONTRATISTA' && (
                <>
                  <div className="space-y-1">
                    <div className="flex items-center gap-2">
                      <span className="font-mono text-xs font-black text-emerald-400 bg-slate-950 px-2 py-0.5 rounded border border-emerald-500/30">
                        {resultadoEscaneo.data.codigoQr}
                      </span>
                      <span className="font-bold text-white text-sm">{resultadoEscaneo.data.empresa}</span>
                    </div>
                    <p className="text-xs text-slate-300">
                      Técnico: {resultadoEscaneo.data.tecnicoNombre} (CC {resultadoEscaneo.data.cedula}) • Póliza RCE: {resultadoEscaneo.data.polizaRce.aseguradora}
                    </p>
                  </div>
                  {resultadoEscaneo.data.polizaRce.vigente && resultadoEscaneo.data.arlPlanilla.vigente ? (
                    <button
                      type="button"
                      onClick={() => onValidarQrContratistaPorteria?.(resultadoEscaneo.data.id)}
                      className="px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl text-xs cursor-pointer"
                    >
                      Autorizar Ingreso SG-SST
                    </button>
                  ) : (
                    <span className="px-3 py-1.5 bg-rose-500/10 border border-rose-500/30 text-rose-400 font-bold text-xs rounded-xl">
                      BLOQUEADO POR ARL / PÓLIZA VENCIDA
                    </span>
                  )}
                </>
              )}

              {resultadoEscaneo.tipo === 'NO_ENCONTRADO' && (
                <div className="text-rose-400 text-xs font-bold flex items-center gap-2">
                  <AlertTriangle className="w-4 h-4" /> El código &ldquo;{resultadoEscaneo.query}&rdquo; no existe o no tiene autorización vigente.
                </div>
              )}
            </div>
          )}
        </div>

        {/* Dos Columnas Unificadas: Residentes (Izquierda) y Contratistas SG-SST (Derecha) */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          
          {/* COLUMNA 1: Pases QR Autorizados por Residentes */}
          <div className="bg-slate-950 border border-slate-800 p-5 rounded-2xl space-y-3">
            <div className="flex items-center justify-between">
              <h3 className="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2">
                <UserCheck className="w-4 h-4 text-cyan-400" /> Pases QR Autorizados por Residentes
              </h3>
              <span className="text-[11px] font-mono text-slate-400">{visitasQrShared.length} registros</span>
            </div>

            <div className="space-y-3 max-h-[380px] overflow-y-auto pr-1">
              {visitasQrShared.map(p => (
                <div
                  key={p.id}
                  className="p-3.5 bg-slate-900 border border-slate-800 rounded-xl flex items-center justify-between gap-3 text-xs"
                >
                  <div className="space-y-1">
                    <div className="flex flex-wrap items-center gap-2">
                      <span className="font-mono font-black text-cyan-400 bg-slate-950 px-2 py-0.5 rounded border border-cyan-500/20">
                        {p.codigoQr || p.codigo}
                      </span>
                      <span className="font-bold text-white text-sm">
                        {p.nombreVisitante || p.visitante}
                      </span>
                    </div>
                    <p className="text-slate-400">
                      Destino: <strong className="text-slate-200">{p.unidad}</strong> | Placa: {p.placaVehiculo || p.placa || 'Peatonal'}
                    </p>
                    <p className="text-[11px] font-mono text-cyan-400">
                      {p.estado === 'Adentro'
                        ? `Adentro desde: ${p.horaIngreso || 'Ahora'}`
                        : p.estado === 'Salió'
                        ? `Salió a las: ${p.horaSalida || p.horaIngreso || '--:--'}`
                        : 'Pendiente de ingreso en garita'}
                    </p>
                  </div>

                  <div className="flex items-center gap-2 shrink-0">
                    <span
                      className={`px-2.5 py-1 rounded-lg font-bold text-[10px] border ${
                        p.estado === 'Autorizado'
                          ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                          : p.estado === 'Adentro'
                          ? 'bg-amber-500/10 text-amber-400 border-amber-500/30'
                          : 'bg-slate-800 text-slate-400 border-slate-700'
                      }`}
                    >
                      {p.estado}
                    </span>

                    <button
                      type="button"
                      onClick={() => handleAccionVisita(p)}
                      className={`px-3 py-1.5 rounded-xl font-bold text-xs transition cursor-pointer ${
                        p.estado === 'Autorizado'
                          ? 'bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-md shadow-emerald-500/20'
                          : p.estado === 'Adentro'
                          ? 'bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-md shadow-amber-500/20'
                          : 'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700'
                      }`}
                    >
                      {p.estado === 'Autorizado'
                        ? 'Dar Ingreso'
                        : p.estado === 'Adentro'
                        ? 'Registrar Salida'
                        : 'Reiniciar'}
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* COLUMNA 2: Contratistas Autorizados por la Administración (SG-SST) */}
          <div className="bg-slate-950 border border-slate-800 p-5 rounded-2xl space-y-3">
            <div className="flex items-center justify-between">
              <h3 className="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2">
                <HardHat className="w-4 h-4 text-emerald-400" /> Contratistas Autorizados (Admin &amp; SG-SST)
              </h3>
              <span className="text-[11px] font-mono text-slate-400">Auditoría Ley 675</span>
            </div>

            <div className="space-y-3 max-h-[380px] overflow-y-auto pr-1">
              {contratistasSgsst.map(c => {
                const apto = c.polizaRce.vigente && c.arlPlanilla.vigente && c.epsSalud.vigente;
                const estaAdentro = c.estadoPorteria === 'Adentro en Labor';
                return (
                  <div
                    key={c.id}
                    className="p-3.5 bg-slate-900 border border-slate-800 rounded-xl flex items-center justify-between gap-3 text-xs"
                  >
                    <div className="space-y-1">
                      <div className="flex flex-wrap items-center gap-2">
                        <span className="font-mono font-black text-emerald-400 text-[11px]">
                          {c.codigoQr}
                        </span>
                        <span className="font-bold text-white text-sm">{c.empresa}</span>
                      </div>
                      <p className="text-slate-400">
                        Técnico: {c.tecnicoNombre} | Póliza:{' '}
                        <strong className={apto ? 'text-emerald-400' : 'text-rose-400'}>
                          {c.polizaRce.aseguradora}
                        </strong>
                      </p>
                      {c.ultimoEscaneo && (
                        <p className="text-[11px] font-mono text-slate-400">{c.ultimoEscaneo}</p>
                      )}
                    </div>

                    <div className="flex items-center gap-2 shrink-0">
                      <span
                        className={`px-2.5 py-1 rounded-lg font-bold text-[10px] border ${
                          !apto
                            ? 'bg-rose-500/10 text-rose-400 border-rose-500/30'
                            : estaAdentro
                            ? 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30'
                            : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                        }`}
                      >
                        {!apto ? 'Bloqueado' : estaAdentro ? 'Adentro en Labor' : 'SG-SST OK'}
                      </span>

                      {apto && (
                        <button
                          type="button"
                          onClick={() => onValidarQrContratistaPorteria?.(c.id)}
                          className={`px-3 py-1.5 rounded-xl font-bold text-xs transition cursor-pointer ${
                            estaAdentro
                              ? 'bg-amber-500 hover:bg-amber-400 text-slate-950'
                              : 'bg-emerald-600 hover:bg-emerald-500 text-white'
                          }`}
                        >
                          {estaAdentro ? 'Registrar Salida' : 'Autorizar Ingreso'}
                        </button>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

        </div>
      </div>

      {/* =====================================================================
          BLOQUE 2: MÓDULO DE ENCOMIENDAS, PAQUETES Y CORREO CON PIN DE RETIRO
         ===================================================================== */}
      <div className="bg-slate-900 border border-slate-800 p-6 rounded-3xl shadow-2xl space-y-5">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
          <div className="flex items-center gap-3">
            <div className="p-3 bg-amber-500/10 text-amber-400 rounded-2xl border border-amber-500/20">
              <Package className="w-6 h-6" />
            </div>
            <div>
              <span className="text-[10px] font-mono font-bold text-amber-400 bg-amber-500/10 px-2.5 py-0.5 rounded border border-amber-500/20 uppercase tracking-widest">
                Submódulo de Custodia y Casilleros
              </span>
              <h3 className="text-lg font-black text-white mt-1">
                Recepción y Entrega de Encomiendas &amp; Correo Certificado
              </h3>
            </div>
          </div>
          <span className="px-3 py-1.5 rounded-xl bg-slate-950 border border-amber-500/30 text-amber-400 text-xs font-mono font-bold">
            📦 {paquetesEnCustodiaCount} Paquetes en Custodia Activa
          </span>
        </div>

        {/* Formulario de Registro de Paquetes */}
        <form
          onSubmit={handleSubmitEncomienda}
          className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 bg-slate-950 p-4 rounded-2xl border border-slate-800"
        >
          <input
            type="text"
            value={unidadPaquete}
            onChange={(e) => setUnidadPaquete(e.target.value)}
            placeholder="Unidad (Ej: Torre 2 - 301)"
            className="p-3 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-amber-400"
            required
          />
          <input
            type="text"
            value={destinatarioPaquete}
            onChange={(e) => setDestinatarioPaquete(e.target.value)}
            placeholder="Nombre Destinatario"
            className="p-3 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-amber-400"
            required
          />
          <select
            value={empresaPaquete}
            onChange={(e) => setEmpresaPaquete(e.target.value)}
            className="p-3 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-amber-400 font-mono"
          >
            <option>MercadoLibre Full</option>
            <option>Amazon Prime</option>
            <option>Servientrega</option>
            <option>Coordinadora</option>
            <option>Interrapidísimo</option>
            <option>Rappi / Mensajería</option>
          </select>
          <input
            type="text"
            value={casilleroPaquete}
            onChange={(e) => setCasilleroPaquete(e.target.value)}
            placeholder="Casillero (Ej: Casillero #12)"
            className="p-3 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-amber-400 font-mono"
            required
          />
          <button
            type="submit"
            className="bg-amber-500 hover:bg-amber-400 text-slate-950 font-black py-3 px-4 rounded-xl text-xs transition cursor-pointer shadow-lg shadow-amber-500/20 flex items-center justify-center gap-2"
          >
            <PlusCircle className="w-4 h-4" /> Registrar y Generar PIN
          </button>
        </form>

        {/* Lista de Encomiendas */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
          {encomiendasShared.map(pkg => (
            <div
              key={pkg.id}
              className="p-4 bg-slate-950 border border-slate-800 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs"
            >
              <div className="space-y-1">
                <div className="flex items-center gap-2">
                  <span className="font-mono font-black text-amber-400 bg-slate-900 px-2.5 py-0.5 rounded border border-amber-500/30">
                    {pkg.pinRetiro}
                  </span>
                  <span className="font-bold text-white text-sm">{pkg.unidad}</span>
                  <span className="text-slate-400">• {pkg.destinatario}</span>
                </div>
                <p className="text-slate-400">
                  Empresa: <strong className="text-slate-200">{pkg.empresa}</strong> ({pkg.guia}) • {pkg.casillero}
                </p>
                <p className="text-[11px] text-slate-500">
                  Llegada: {pkg.fechaLlegada} {pkg.fechaEntrega ? `• Entregado: ${pkg.fechaEntrega}` : ''}
                </p>
              </div>

              <div className="flex items-center gap-2 shrink-0">
                {pkg.estado === 'En Custodia' ? (
                  <>
                    <input
                      type="text"
                      placeholder="PIN (Opcional)"
                      value={pinValidacionMap[pkg.id] || ''}
                      onChange={(e) =>
                        setPinValidacionMap(prev => ({ ...prev, [pkg.id]: e.target.value }))
                      }
                      className="w-24 p-2 bg-slate-900 border border-slate-700 rounded-lg text-[11px] font-mono text-white outline-none focus:border-emerald-400"
                    />
                    <button
                      type="button"
                      onClick={() => handleEntregarPaquetePorteria(pkg)}
                      className="px-3 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl transition cursor-pointer flex items-center gap-1"
                    >
                      <CheckCircle2 className="w-3.5 h-3.5" /> Entregar
                    </button>
                  </>
                ) : (
                  <span className="px-3 py-1 rounded-lg bg-slate-900 text-emerald-400 border border-emerald-500/20 font-bold text-[11px]">
                    Entregado ✓
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* =====================================================================
          BLOQUE 3: MÓDULO DE RONDAS PERIMETRALES Y CHECKPOINTS NFC/QR
         ===================================================================== */}
      <div className="bg-slate-900 border border-slate-800 p-6 rounded-3xl shadow-2xl space-y-5">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
          <div className="flex items-center gap-3">
            <div className="p-3 bg-emerald-500/10 text-emerald-400 rounded-2xl border border-emerald-500/20">
              <Compass className="w-6 h-6" />
            </div>
            <div>
              <span className="text-[10px] font-mono font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded border border-emerald-500/20 uppercase tracking-widest">
                Bitácora Electrónica de Rondas • Checkpoints NFC / QR
              </span>
              <h3 className="text-lg font-black text-white mt-1">
                Control de Rondas de Vigilancia y Reporte de Novedades a Administración
              </h3>
            </div>
          </div>
          <span className="px-3 py-1.5 rounded-xl bg-slate-950 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-bold">
            🛡️ {rondasVerificadasCount} / {puntosRonda.length} Checkpoints Verificados
          </span>
        </div>

        {/* Formulario de Registro de Punto de Control */}
        <form
          onSubmit={handleRegistrarCheckpointRonda}
          className="grid grid-cols-1 md:grid-cols-4 gap-3 bg-slate-950 p-4 rounded-2xl border border-slate-800"
        >
          <select
            value={puntoSeleccionadoId}
            onChange={(e) => setPuntoSeleccionadoId(e.target.value)}
            className="p-3 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-emerald-400 font-mono"
          >
            {puntosRonda.map(p => (
              <option key={p.id} value={p.id}>
                {p.codigoNfcQr} — {p.nombrePunto}
              </option>
            ))}
          </select>

          <select
            value={estadoRondaInput}
            onChange={(e) => setEstadoRondaInput(e.target.value as 'Verificado OK' | 'Novedad Reportada')}
            className="p-3 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-emerald-400 font-mono"
          >
            <option value="Verificado OK">✅ Estado: Verificado Normal (Sin Novedad)</option>
            <option value="Novedad Reportada">⚠️ Estado: Reportar Daño / Novedad a Admin</option>
          </select>

          <input
            type="text"
            value={observacionRondaInput}
            onChange={(e) => setObservacionRondaInput(e.target.value)}
            placeholder="Observación o hallazgo en el punto..."
            className="p-3 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-emerald-400"
          />

          <button
            type="submit"
            className="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black py-3 px-4 rounded-xl text-xs transition cursor-pointer shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2"
          >
            <MapPin className="w-4 h-4" /> Marcar Checkpoint en Ronda
          </button>
        </form>

        {/* Tarjetas de Puntos de Control (Checkpoints) */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {puntosRonda.map(punto => (
            <div
              key={punto.id}
              className="p-4 bg-slate-950 border border-slate-800 rounded-2xl flex flex-col justify-between gap-3 text-xs"
            >
              <div className="space-y-1.5">
                <div className="flex items-center justify-between gap-2">
                  <span className="font-mono text-[10px] font-black text-cyan-400 bg-slate-900 px-2 py-0.5 rounded border border-cyan-500/20">
                    {punto.codigoNfcQr}
                  </span>
                  <span
                    className={`px-2 py-0.5 rounded font-bold text-[10px] border ${
                      punto.estadoUltimoChequeo === 'Verificado OK'
                        ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                        : punto.estadoUltimoChequeo === 'Novedad Reportada'
                        ? 'bg-rose-500/10 text-rose-400 border-rose-500/30'
                        : 'bg-amber-500/10 text-amber-400 border-amber-500/30'
                    }`}
                  >
                    {punto.estadoUltimoChequeo}
                  </span>
                </div>
                <h4 className="font-bold text-white text-sm">{punto.nombrePunto}</h4>
                <p className="text-slate-400 text-[11px]">📍 {punto.ubicacion}</p>
                <p className="text-slate-300 text-xs bg-slate-900 p-2 rounded-lg border border-slate-800">
                  {punto.observacion}
                </p>
              </div>

              <div className="pt-2 border-t border-slate-800 flex items-center justify-between gap-2">
                <span className="text-[11px] font-mono text-slate-400">
                  🕒 {punto.ultimaHora}
                </span>
                <div className="flex gap-1.5">
                  <button
                    type="button"
                    onClick={() => handleMarcarRondaDirecta(punto.id, 'Verificado OK')}
                    className="px-2.5 py-1 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-lg font-bold text-[11px] cursor-pointer"
                  >
                    Validar OK
                  </button>
                  <button
                    type="button"
                    onClick={() => handleMarcarRondaDirecta(punto.id, 'Novedad Reportada')}
                    className="px-2.5 py-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg font-bold text-[11px] cursor-pointer"
                  >
                    Reportar Falla
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  );
}