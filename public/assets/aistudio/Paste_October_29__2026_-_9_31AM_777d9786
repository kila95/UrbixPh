import React, { useState } from 'react';

export default function App() {
  const [activeTab, setActiveTab] = useState('overview');

  // 1. Copropiedades & Salud Operativa (Módulo 1)
  const [coproperties, setCoproperties] = useState([
    { id: 1, name: 'P.H. Reserva del Tesoro', city: 'El Poblado, Medellín', units: 120, collectionRate: 94.5, health: 'Óptimo' },
    { id: 2, name: 'Edificio Torre El Poblado', city: 'El Poblado, Medellín', units: 45, collectionRate: 88.2, health: 'Estable' },
    { id: 3, name: 'C.C. San Diego (Localidades)', city: 'Centro, Medellín', units: 80, collectionRate: 79.0, health: 'Crítico / Alerta' }
  ]);
  const [presupuestoBase, setPresupuestoBase] = useState(45000000);
  const [ipcProyectado, setIpcProyectado] = useState(5.5);
  const [salarioMinimoInc, setSalarioMinimoInc] = useState(7.0);
  const nuevoPresupuesto = Math.round(presupuestoBase * (1 + (ipcProyectado + salarioMinimoInc) / 200));

  // 2. Control de Roles (RBAC) & Auditoría
  const [users, setUsers] = useState([
    { id: 1, name: 'Esteban Ochoa (Root)', email: 'admin@urbix.ph', role: 'super_admin', coproperty: 'Global', tempPass: '********' },
    { id: 2, name: 'Carlos Mario Pineda', email: 'carlos.admin@urbix.ph', role: 'admin', coproperty: 'Reserva del Tesoro', tempPass: '********' }
  ]);
  const [auditLogs] = useState([
    { id: 101, timestamp: '2026-10-29 08:30', user: 'Esteban Ochoa (Root)', action: 'UPDATE_ROLE', details: 'Modificó rol de usuario ID 2 a admin' }
  ]);

  const handleRoleChange = (userId, newRole) => {
    const targetUser = users.find(u => u.id === userId);
    const superAdminsCount = users.filter(u => u.role === 'super_admin').length;
    
    if (targetUser.role === 'super_admin' && newRole !== 'super_admin' && superAdminsCount <= 1) {
      alert("⚠️ ACCIÓN BLOQUEADA: El sistema requiere al menos un Superadministrador activo.");
      return;
    }
    setUsers(users.map(u => u.id === userId ? { ...u, role: newRole } : u));
  };

  // 4. Prejurídico Ley 675
  const [morosos] = useState([
    { id: 101, apto: 'Torre 1 - 502', propietario: 'Martha Lucía Gómez', capital: 3800000, diasMora: 112 },
    { id: 102, apto: 'Local 14 (CC San Diego)', propietario: 'Inversiones del Valle SAS', capital: 7500000, diasMora: 145 }
  ]);
  const TASA_INTERES_MENSUAL = 0.025; 
  const calcularIntereses = (capital, dias) => Math.round(capital * TASA_INTERES_MENSUAL * (dias / 30));

  // 5. Asambleas & Quórum
  const [quorumActual] = useState(78.4);
  const [tipoMayoria, setTipoMayoria] = useState('ordinaria');

  // 6. Infraestructura
  const [appVersion, setAppVersion] = useState('v3.1.0-enterprise');
  const [updating, setUpdating] = useState(false);
  const handleSystemUpdate = () => {
    setUpdating(true);
    setTimeout(() => {
      setAppVersion('v3.1.1-patch');
      setUpdating(false);
      alert("✅ Sistema actualizado correctamente.");
    }, 1000);
  };

  // 7. Suscripciones SaaS & Credenciales Admin
  const [subscriptions, setSubscriptions] = useState([
    { id: 'sub_01', client: 'P.H. Reserva del Tesoro', plan: 'Plan Enterprise', amount: 450000, dianStatus: 'Emitida & Aceptada', status: 'Al día' },
    { id: 'sub_02', client: 'Edificio Torre El Poblado', plan: 'Plan Estándar', amount: 280000, dianStatus: 'Emitida & Aceptada', status: 'Al día' }
  ]);
  const [showAddModal, setShowAddModal] = useState(false);
  const [newClientName, setNewClientName] = useState('');
  const [newAdminName, setNewAdminName] = useState('');
  const [newAdminEmail, setNewAdminEmail] = useState('');
  const [newPlan, setNewPlan] = useState('Plan Estándar');
  const [newAmount, setNewAmount] = useState(280000);
  const [createdCredentials, setCreatedCredentials] = useState(null);

  const handleRegisterClient = (e) => {
    e.preventDefault();
    if (!newClientName || !newAdminName || !newAdminEmail) {
      alert("⚠️ Completa todos los campos obligatorios.");
      return;
    }
    const generatedPassword = "Urbix@" + Math.random().toString(36).slice(-6);

    setCoproperties([...coproperties, {
      id: coproperties.length + 1, name: newClientName, city: 'Medellín', units: 50, collectionRate: 100.0, health: 'Óptimo'
    }]);

    setSubscriptions([...subscriptions, {
      id: `sub_0${subscriptions.length + 1}`, client: newClientName, plan: newPlan, amount: Number(newAmount), dianStatus: 'Emitida (DIAN)', status: 'Al día'
    }]);

    setUsers([...users, {
      id: users.length + 1, name: newAdminName, email: newAdminEmail, role: 'admin', coproperty: newClientName, tempPass: generatedPassword
    }]);

    setCreatedCredentials({ client: newClientName, name: newAdminName, email: newAdminEmail, pass: generatedPassword });
    setShowAddModal(false);
    setNewClientName(''); setNewAdminName(''); setNewAdminEmail('');
  };

  return (
    <div style={{ minHeight: '100vh', backgroundColor: '#0a0a0a', color: '#f8fafc', padding: '24px', fontFamily: 'sans-serif' }}>
      
      {/* HEADER PRINCIPAL */}
      <div style={{ backgroundColor: '#141416', border: '1px solid #262629', padding: '24px', borderRadius: '12px', marginBottom: '24px', display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '16px' }}>
        <div>
          <span style={{ fontSize: '10px', fontFamily: 'monospace', backgroundColor: 'rgba(16, 185, 129, 0.1)', color: '#34d399', border: '1px solid rgba(16, 185, 129, 0.3)', padding: '2px 6px', borderRadius: '4px' }}>
            [ URBIX PH - MASTER ROOT ENTERPRISE ]
          </span>
          <h1 style={{ fontSize: '24px', fontWeight: '900', color: '#ffffff', margin: '8px 0 4px 0' }}>
            Consola Central del Superadministrador
          </h1>
          <p style={{ fontSize: '14px', color: '#94a3b8', margin: 0 }}>
            Medellín & Valle de Aburrá • Ley 675 • Gestión Multi-Tenant & Facturación DIAN
          </p>
        </div>
        <div style={{ backgroundColor: '#1c1c1f', padding: '10px 16px', borderRadius: '8px', border: '1px solid #262629', fontSize: '12px', fontFamily: 'monospace' }}>
          <p style={{ color: '#34d399', fontWeight: 'bold', margin: 0 }}>● Supabase: Conectado</p>
          <p style={{ color: '#64748b', margin: '2px 0 0 0' }}>RLS Active • HMAC Webhooks</p>
        </div>
      </div>

      {/* BARRA DE NAVEGACIÓN MAESTRA (1 AL 7) */}
      <div style={{ display: 'flex', borderBottom: '1px solid #262629', marginBottom: '24px', gap: '6px', fontFamily: 'monospace', fontSize: '12px', overflowX: 'auto', paddingBottom: '4px' }}>
        <button onClick={() => setActiveTab('overview')} style={{ padding: '12px 14px', borderBottom: activeTab === 'overview' ? '2px solid #10b981' : '2px solid transparent', color: activeTab === 'overview' ? '#34d399' : '#94a3b8', backgroundColor: activeTab === 'overview' ? '#141416' : 'transparent', borderTop: 'none', borderLeft: 'none', borderRight: 'none', cursor: 'pointer', fontWeight: 'bold', whiteSpace: 'nowrap' }}>1. Salud Copropiedades</button>
        <button onClick={() => setActiveTab('rbac')} style={{ padding: '12px 14px', borderBottom: activeTab === 'rbac' ? '2px solid #06b6d4' : '2px solid transparent', color: activeTab === 'rbac' ? '#22d3ee' : '#94a3b8', backgroundColor: activeTab === 'rbac' ? '#141416' : 'transparent', borderTop: 'none', borderLeft: 'none', borderRight: 'none', cursor: 'pointer', fontWeight: 'bold', whiteSpace: 'nowrap' }}>2. RBAC & Auditoría</button>
        <button onClick={() => setActiveTab('finance')} style={{ padding: '12px 14px', borderBottom: activeTab === 'finance' ? '2px solid #10b981' : '2px solid transparent', color: activeTab === 'finance' ? '#34d399' : '#94a3b8', backgroundColor: activeTab === 'finance' ? '#141416' : 'transparent', borderTop: 'none', borderLeft: 'none', borderRight: 'none', cursor: 'pointer', fontWeight: 'bold', whiteSpace: 'nowrap' }}>3. P&L Global Firma</button>
        <button onClick={() => setActiveTab('legal')} style={{ padding: '12px 14px', borderBottom: activeTab === 'legal' ? '2px solid #f59e0b' : '2px solid transparent', color: activeTab === 'legal' ? '#f59e0b' : '#94a3b8', backgroundColor: activeTab === 'legal' ? '#141416' : 'transparent', borderTop: 'none', borderLeft: 'none', borderRight: 'none', cursor: 'pointer', fontWeight: 'bold', whiteSpace: 'nowrap' }}>4. Prejurídico Ley 675</button>
        <button onClick={() => setActiveTab('assembly')} style={{ padding: '12px 14px', borderBottom: activeTab === 'assembly' ? '2px solid #3b82f6' : '2px solid transparent', color: activeTab === 'assembly' ? '#60a5fa' : '#94a3b8', backgroundColor: activeTab === 'assembly' ? '#141416' : 'transparent', borderTop: 'none', borderLeft: 'none', borderRight: 'none', cursor: 'pointer', fontWeight: 'bold', whiteSpace: 'nowrap' }}>5. Asambleas & Quórum</button>
        <button onClick={() => setActiveTab('infrastructure')} style={{ padding: '12px 14px', borderBottom: activeTab === 'infrastructure' ? '2px solid #a855f7' : '2px solid transparent', color: activeTab === 'infrastructure' ? '#c084fc' : '#94a3b8', backgroundColor: activeTab === 'infrastructure' ? '#141416' : 'transparent', borderTop: 'none', borderLeft: 'none', borderRight: 'none', cursor: 'pointer', fontWeight: 'bold', whiteSpace: 'nowrap' }}>6. Infraestructura DB</button>
        <button onClick={() => setActiveTab('billing')} style={{ padding: '12px 14px', borderBottom: activeTab === 'billing' ? '2px solid #34d399' : '2px solid transparent', color: activeTab === 'billing' ? '#34d399' : '#94a3b8', backgroundColor: activeTab === 'billing' ? '#141416' : 'transparent', borderTop: 'none', borderLeft: 'none', borderRight: 'none', cursor: 'pointer', fontWeight: 'bold', whiteSpace: 'nowrap' }}>🚀 7. SaaS & DIAN</button>
      </div>

      {/* ================= 1. SALUD COPROPIEDADES (MÓDULO 1 MEJORADO) ================= */}
      {activeTab === 'overview' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
          <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
            <h3 style={{ margin: '0 0 16px 0', fontSize: '16px', color: '#ffffff' }}>1. Matriz de Salud Operativa y Recaudo (Valle de Aburrá)</h3>
            <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: '14px' }}>
              <thead>
                <tr style={{ backgroundColor: '#1c1c1f', color: '#94a3b8', fontFamily: 'monospace', fontSize: '12px' }}>
                  <th style={{ padding: '12px' }}>Copropiedad</th>
                  <th style={{ padding: '12px' }}>Ubicación</th>
                  <th style={{ padding: '12px' }}>Unidades</th>
                  <th style={{ padding: '12px' }}>Eficacia Recaudo</th>
                  <th style={{ padding: '12px' }}>Estado de Salud</th>
                </tr>
              </thead>
              <tbody>
                {coproperties.map(c => (
                  <tr key={c.id} style={{ borderBottom: '1px solid #262629' }}>
                    <td style={{ padding: '12px', fontWeight: '500', color: '#fff' }}>{c.name}</td>
                    <td style={{ padding: '12px', color: '#94a3b8', fontSize: '12px' }}>{c.city}</td>
                    <td style={{ padding: '12px', fontFamily: 'monospace', color: '#cbd5e1' }}>{c.units}</td>
                    <td style={{ padding: '12px', fontFamily: 'monospace', color: '#34d399' }}>{c.collectionRate}%</td>
                    <td style={{ padding: '12px' }}>
                      <span style={{ padding: '4px 8px', borderRadius: '4px', fontSize: '10px', fontFamily: 'monospace', fontWeight: 'bold', backgroundColor: c.health.includes('Óptimo') ? 'rgba(52, 211, 153, 0.1)' : c.health.includes('Estable') ? 'rgba(59, 130, 246, 0.1)' : 'rgba(248, 113, 113, 0.1)', color: c.health.includes('Óptimo') ? '#34d399' : c.health.includes('Estable') ? '#60a5fa' : '#f87171' }}>
                        {c.health.toUpperCase()}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* Simulador Financiero de Incremento Anual */}
          <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
            <h3 style={{ margin: '0 0 8px 0', fontSize: '16px', color: '#ffffff' }}>Simulador Financiero de Incremento Anual (IPC & Salario Mínimo)</h3>
            <p style={{ fontSize: '13px', color: '#94a3b8', margin: '0 0 20px 0' }}>Proyección automática del impacto en la cuota de administración para la asamblea ordinaria.</p>
            
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '16px', marginBottom: '20px' }}>
              <div>
                <label style={{ fontSize: '11px', fontFamily: 'monospace', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>PRESUPUESTO BASE (COP)</label>
                <input type="number" value={presupuestoBase} onChange={(e) => setPresupuestoBase(Number(e.target.value))} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px', fontSize: '13px', fontFamily: 'monospace' }} />
              </div>
              <div>
                <label style={{ fontSize: '11px', fontFamily: 'monospace', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>IPC PROYECTADO (%)</label>
                <input type="number" value={ipcProyectado} onChange={(e) => setIpcProyectado(Number(e.target.value))} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px', fontSize: '13px', fontFamily: 'monospace' }} />
              </div>
              <div>
                <label style={{ fontSize: '11px', fontFamily: 'monospace', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>INCREMENTO SMMLV (%)</label>
                <input type="number" value={salarioMinimoInc} onChange={(e) => setSalarioMinimoInc(Number(e.target.value))} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px', fontSize: '13px', fontFamily: 'monospace' }} />
              </div>
            </div>

            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', backgroundColor: '#1c1c1f', padding: '16px', borderRadius: '8px', border: '1px solid #262629', fontFamily: 'monospace' }}>
              <div>
                <span style={{ fontSize: '11px', color: '#94a3b8', display: 'block' }}>NUEVO PRESUPUESTO PROYECTADO:</span>
                <span style={{ fontSize: '20px', fontWeight: 'bold', color: '#34d399' }}>${nuevoPresupuesto.toLocaleString()} COP</span>
              </div>
              <button onClick={() => alert("📊 Borrador de presupuesto para asamblea exportado.")} style={{ backgroundColor: '#10b981', color: '#09090b', fontWeight: 'bold', fontSize: '11px', padding: '10px 16px', borderRadius: '6px', border: 'none', cursor: 'pointer', fontFamily: 'monospace' }}>
                EXPORTAR BORRADOR
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ================= 2. RBAC & AUDITORÍA ================= */}
      {activeTab === 'rbac' && (
        <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
          <h3 style={{ margin: '0 0 8px 0', fontSize: '16px', color: '#ffffff' }}>Control de Accesos y Credenciales de Usuarios</h3>
          <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: '14px', marginTop: '16px' }}>
            <thead>
              <tr style={{ backgroundColor: '#1c1c1f', color: '#94a3b8', fontFamily: 'monospace', fontSize: '12px' }}>
                <th style={{ padding: '12px' }}>Usuario / Email</th>
                <th style={{ padding: '12px' }}>Rol</th>
                <th style={{ padding: '12px' }}>Contraseña Temporal</th>
                <th style={{ padding: '12px', textAlign: 'right' }}>Cambiar Rol</th>
              </tr>
            </thead>
            <tbody>
              {users.map(u => (
                <tr key={u.id} style={{ borderBottom: '1px solid #262629' }}>
                  <td style={{ padding: '12px', color: '#fff' }}>{u.name} <br/><span style={{ fontSize: '11px', color: '#94a3b8', fontFamily: 'monospace' }}>{u.email}</span></td>
                  <td style={{ padding: '12px', color: '#34d399', fontFamily: 'monospace' }}>{u.role.toUpperCase()}</td>
                  <td style={{ padding: '12px', color: '#f59e0b', fontFamily: 'monospace' }}>{u.tempPass}</td>
                  <td style={{ padding: '12px', textAlign: 'right' }}>
                    <select value={u.role} onChange={(e) => handleRoleChange(u.id, e.target.value)} style={{ backgroundColor: '#1c1c1f', color: '#fff', padding: '4px', borderRadius: '4px', fontFamily: 'monospace', fontSize: '12px' }}>
                      <option value="super_admin">Super Admin</option>
                      <option value="admin">Administrador</option>
                      <option value="supervisor">Supervisor</option>
                    </select>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* ================= 3. P&L GLOBAL ================= */}
      {activeTab === 'finance' && (
        <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
          <h3 style={{ margin: '0 0 8px 0', fontSize: '16px', color: '#ffffff' }}>Consolidado Financiero y Tesorería (P&L Global)</h3>
          <p style={{ fontSize: '13px', color: '#94a3b8', margin: 0 }}>Flujo de caja consolidado de la firma administradora y pasarelas de pago.</p>
        </div>
      )}

      {/* ================= 4. PREJURÍDICO LEY 675 ================= */}
      {activeTab === 'legal' && (
        <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
          <h3 style={{ margin: '0 0 8px 0', fontSize: '16px', color: '#ffffff' }}>Gestión Prejurídica y Cartera Coactiva (Ley 675)</h3>
          <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: '14px', marginTop: '16px' }}>
            <thead>
              <tr style={{ backgroundColor: '#1c1c1f', color: '#94a3b8', fontFamily: 'monospace', fontSize: '12px' }}>
                <th style={{ padding: '12px' }}>Inmueble</th>
                <th style={{ padding: '12px' }}>Propietario</th>
                <th style={{ padding: '12px' }}>Capital Base</th>
                <th style={{ padding: '12px' }}>Intereses Ley 675</th>
              </tr>
            </thead>
            <tbody>
              {morosos.map(m => (
                <tr key={m.id} style={{ borderBottom: '1px solid #262629' }}>
                  <td style={{ padding: '12px', color: '#fff' }}>{m.apto}</td>
                  <td style={{ padding: '12px', color: '#94a3b8' }}>{m.propietario}</td>
                  <td style={{ padding: '12px', fontFamily: 'monospace', color: '#cbd5e1' }}>${m.capital.toLocaleString()}</td>
                  <td style={{ padding: '12px', fontFamily: 'monospace', color: '#f87171' }}>+${calcularIntereses(m.capital, m.diasMora).toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* ================= 5. ASAMBLEAS & QUÓRUM ================= */}
      {activeTab === 'assembly' && (
        <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
          <h3 style={{ margin: '0 0 8px 0', fontSize: '16px', color: '#ffffff' }}>Simulador de Quórum Calificado y Votación por Coeficientes</h3>
          <p style={{ fontSize: '13px', color: '#94a3b8', margin: '0 0 16px 0' }}>Quórum actual registrado: <strong style={{ color: '#34d399' }}>{quorumActual}%</strong></p>
        </div>
      )}

      {/* ================= 6. INFRAESTRUCTURA ================= */}
      {activeTab === 'infrastructure' && (
        <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
          <h3 style={{ margin: '0 0 8px 0', fontSize: '16px', color: '#ffffff' }}>Infraestructura y Túneles Remotos</h3>
          <p style={{ fontSize: '13px', color: '#94a3b8', margin: '0 0 16px 0' }}>Versión del software: <code style={{ color: '#34d399' }}>{appVersion}</code></p>
          <button onClick={handleSystemUpdate} disabled={updating} style={{ backgroundColor: '#10b981', color: '#09090b', fontWeight: 'bold', fontSize: '11px', padding: '10px 16px', borderRadius: '6px', border: 'none', cursor: 'pointer', fontFamily: 'monospace' }}>
            {updating ? "DESPLEGANDO PARCHE..." : "FORZAR ACTUALIZACIÓN DE SISTEMA"}
          </button>
        </div>
      )}

      {/* ================= 7. SUSCRIPCIONES & LOGIN (MÓDULO 7) ================= */}
      {activeTab === 'billing' && (
        <div>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))', gap: '16px', marginBottom: '24px' }}>
            <div style={{ backgroundColor: '#141416', border: '1px solid #262629', padding: '20px', borderRadius: '12px' }}>
              <span style={{ fontSize: '11px', fontFamily: 'monospace', color: '#94a3b8' }}>MRR RECURRENTE</span>
              <div style={{ fontSize: '24px', fontWeight: '900', fontFamily: 'monospace', color: '#34d399', marginTop: '8px' }}>$1.38M COP/mes</div>
            </div>
            <div style={{ backgroundColor: '#141416', border: '1px solid #262629', padding: '20px', borderRadius: '12px' }}>
              <span style={{ fontSize: '11px', fontFamily: 'monospace', color: '#94a3b8' }}>CLIENTES ACTIVOS</span>
              <div style={{ fontSize: '24px', fontWeight: '900', fontFamily: 'monospace', color: '#ffffff', marginTop: '8px' }}>{coproperties.length} Copropiedades</div>
            </div>
          </div>

          <div style={{ marginBottom: '20px', display: 'flex', justifyContent: 'flex-end' }}>
            <button onClick={() => { setShowAddModal(!showAddModal); setCreatedCredentials(null); }} style={{ backgroundColor: '#34d399', color: '#09090b', fontWeight: 'bold', fontSize: '12px', padding: '10px 16px', borderRadius: '8px', border: 'none', cursor: 'pointer', fontFamily: 'monospace' }}>
              {showAddModal ? "✕ Cerrar Formulario" : "+ Inscribir Copropiedad & Crear Login Admin"}
            </button>
          </div>

          {createdCredentials && (
            <div style={{ backgroundColor: 'rgba(52, 211, 153, 0.05)', border: '1px solid #34d399', borderRadius: '12px', padding: '20px', marginBottom: '24px' }}>
              <h4 style={{ margin: '0 0 8px 0', color: '#34d399', fontSize: '15px' }}>🎉 ¡Cliente y Credenciales de Login Generadas con Éxito!</h4>
              <p style={{ fontSize: '12px', color: '#cbd5e1', margin: '0 0 12px 0' }}>Comparte esta información con el administrador de <strong>{createdCredentials.client}</strong>:</p>
              <div style={{ backgroundColor: '#1c1c1f', padding: '12px', borderRadius: '6px', fontFamily: 'monospace', fontSize: '13px', color: '#fff' }}>
                <p style={{ margin: '0 0 4px 0' }}>👤 <strong>Nombre:</strong> {createdCredentials.name}</p>
                <p style={{ margin: '0 0 4px 0' }}>✉️ <strong>Correo de Login:</strong> <span style={{ color: '#34d399' }}>{createdCredentials.email}</span></p>
                <p style={{ margin: '0' }}>🔑 <strong>Contraseña Temporal:</strong> <span style={{ color: '#f59e0b' }}>{createdCredentials.pass}</span></p>
              </div>
            </div>
          )}

          {showAddModal && (
            <div style={{ backgroundColor: '#141416', border: '1px solid #34d399', borderRadius: '12px', padding: '24px', marginBottom: '24px' }}>
              <h3 style={{ margin: '0 0 6px 0', fontSize: '16px', color: '#ffffff' }}>Alta de Nuevo Cliente y Generación de Credenciales de Acceso</h3>
              <form onSubmit={handleRegisterClient} style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '16px', marginTop: '16px' }}>
                <div>
                  <label style={{ fontSize: '11px', fontFamily: 'monospace', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>NOMBRE DE LA COPROPIEDAD *</label>
                  <input type="text" placeholder="Ej. Edificio Portal del Valle" value={newClientName} onChange={(e) => setNewClientName(e.target.value)} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px', fontSize: '13px' }} />
                </div>
                <div>
                  <label style={{ fontSize: '11px', fontFamily: 'monospace', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>NOMBRE DEL ADMINISTRADOR *</label>
                  <input type="text" placeholder="Ej. Andrés Felipe Ruiz" value={newAdminName} onChange={(e) => setNewAdminName(e.target.value)} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px', fontSize: '13px' }} />
                </div>
                <div>
                  <label style={{ fontSize: '11px', fontFamily: 'monospace', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>CORREO DE LOGIN *</label>
                  <input type="email" placeholder="andres.admin@portalvalle.com" value={newAdminEmail} onChange={(e) => setNewAdminEmail(e.target.value)} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px', fontSize: '13px' }} />
                </div>
                <div>
                  <label style={{ fontSize: '11px', fontFamily: 'monospace', color: '#94a3b8', display: 'block', marginBottom: '4px' }}>PLAN SaaS</label>
                  <select value={newPlan} onChange={(e) => { setNewPlan(e.target.value); setNewAmount(e.target.value.includes('Enterprise') ? 450000 : 280000); }} style={{ width: '100%', backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#fff', padding: '8px', borderRadius: '6px', fontSize: '13px' }}>
                    <option value="Plan Estándar">Plan Estándar (280.000 COP/mes)</option>
                    <option value="Plan Enterprise">Plan Enterprise (450.000 COP/mes)</option>
                  </select>
                </div>
                <div style={{ gridColumn: '1 / -1', display: 'flex', justifyContent: 'flex-end', gap: '12px', marginTop: '10px' }}>
                  <button type="button" onClick={() => setShowAddModal(false)} style={{ backgroundColor: 'transparent', color: '#94a3b8', border: '1px solid #262629', padding: '8px 16px', borderRadius: '6px', cursor: 'pointer', fontFamily: 'monospace', fontSize: '11px' }}>Cancelar</button>
                  <button type="submit" style={{ backgroundColor: '#10b981', color: '#09090b', fontWeight: 'bold', border: 'none', padding: '8px 20px', borderRadius: '6px', cursor: 'pointer', fontFamily: 'monospace', fontSize: '11px' }}>CREAR CLIENTE & CONTRASEÑA</button>
                </div>
              </form>
            </div>
          )}

          <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
            <h3 style={{ margin: '0 0 16px 0', fontSize: '16px', color: '#ffffff' }}>Estado de Suscripciones Clientes SaaS</h3>
            <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: '14px' }}>
              <thead>
                <tr style={{ backgroundColor: '#1c1c1f', color: '#94a3b8', fontFamily: 'monospace', fontSize: '12px' }}>
                  <th style={{ padding: '12px' }}>Copropiedad</th>
                  <th style={{ padding: '12px' }}>Plan</th>
                  <th style={{ padding: '12px' }}>Valor Mensual</th>
                  <th style={{ padding: '12px' }}>Estado</th>
                  <th style={{ padding: '12px', textAlign: 'right' }}>Gestión</th>
                </tr>
              </thead>
              <tbody>
                {subscriptions.map(sub => (
                  <tr key={sub.id} style={{ borderBottom: '1px solid #262629' }}>
                    <td style={{ padding: '12px', fontWeight: '500', color: '#fff' }}>{sub.client}</td>
                    <td style={{ padding: '12px', color: '#94a3b8', fontFamily: 'monospace', fontSize: '12px' }}>{sub.plan}</td>
                    <td style={{ padding: '12px', fontFamily: 'monospace', color: '#34d399' }}>${sub.amount.toLocaleString()} COP</td>
                    <td style={{ padding: '12px' }}>
                      <span style={{ padding: '3px 8px', borderRadius: '4px', fontSize: '10px', fontFamily: 'monospace', fontWeight: 'bold', backgroundColor: sub.status === 'Al día' ? 'rgba(52, 211, 153, 0.1)' : 'rgba(248, 113, 113, 0.1)', color: sub.status === 'Al día' ? '#34d399' : '#f87171' }}>
                        {sub.status.toUpperCase()}
                      </span>
                    </td>
                    <td style={{ padding: '12px', textAlign: 'right' }}>
                      <button onClick={() => setSubscriptions(subscriptions.map(s => s.id === sub.id ? {...s, status: s.status === 'Al día' ? 'Suspendido' : 'Al día'} : s))} style={{ backgroundColor: '#1c1c1f', border: '1px solid #262629', color: sub.status === 'Al día' ? '#f87171' : '#34d399', padding: '4px 10px', borderRadius: '4px', fontSize: '11px', fontFamily: 'monospace', cursor: 'pointer', fontWeight: 'bold' }}>
                        {sub.status === 'Al día' ? 'Suspender' : 'Reactivar'}
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

    </div>
  );
}