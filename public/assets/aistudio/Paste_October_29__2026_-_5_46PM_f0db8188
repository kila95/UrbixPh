import React, { useState } from 'react';
import { 
  Building2, Users, FileText, DollarSign, Wrench, 
  AlertTriangle, CheckCircle, Clock, Search, Plus, Trash2, 
  Edit, ArrowRight, Activity, Database, Lock, Unlock, LogOut,
  Bell, Eye, Check, X, Phone, Truck, Package, MapPin, Radio,
  Camera, AlertOctagon, RefreshCw, BarChart2, Key, ShieldCheck, QrCode, Share2
} from 'lucide-react';

// =========================================================================
// URBIX PH - VERSIÓN 3.0 (CONSOLA UNIFICADA + PORTAL RESIDENTE)
// =========================================================================

export default function UrbixPHApp() {
  // Estado Global de Roles (Una sola barra de navegación unificada)
  const [currentRole, setCurrentRole] = useState('vigilante'); // 'admin', 'supervisor', 'vigilante', 'residente'
  const [activeTabAdmin, setActiveTabAdmin] = useState('cartera');
  const [activeTabSupervisor, setActiveTabSupervisor] = useState('caja');
  
  // Pestañas internas de la Consola del Vigilante (Todo en Uno)
  const [activeTabVigilante, setActiveTabVigilante] = useState('paquetes'); 
  
  // Pestañas internas del Portal Residente
  const [activeTabResidente, setActiveTabResidente] = useState('qr');

  // Estados Compartidos (Base de Datos Simulada)
  const [unidades, setUnidades] = useState([
    { id: '1', numero: 'Torre 1 - 101', propietario: 'Carlos Pérez', coeficiente: 0.0125, cuota: 450000, saldo: 0, cartera: 'Al día' },
    { id: '2', numero: 'Torre 2 - 301', propietario: 'Esteban Ochoa', coeficiente: 0.0125, cuota: 450000, saldo: 450000, cartera: 'Mora 30' },
  ]);

  const [accesosPorteria, setAccesosPorteria] = useState([
    { id: '1', visitante: 'Juan Carlos Mesa', cedula: '10389234', destino: 'Torre 1 - 101', motivo: 'Visita', vehiculo: 'Carro (V-01)', estado: 'Adentro' }
  ]);

  // Paquetería Blindada con Fotos y Firmas (Dentro del rol de Vigilante)
  const [paquetesBlindados, setPaquetesBlindados] = useState([
    { 
      id: '1', 
      destino: 'Torre 2 - 301', 
      empresa: 'Servientrega', 
      descripcion: 'Caja mediana sellada (Amazon)', 
      fotoLlegada: 'https://images.unsplash.com/photo-1566576912321-d58ddd7a6088?auto=format&fit=crop&w=300&q=80',
      estado: 'En Custodia', 
      fechaLlegada: '2026-10-24 08:30 AM',
      recibidoPorResidente: null,
      firmaResidente: null
    }
  ]);

  // Control de Llaves (Dentro del rol de Vigilante)
  const [controlLlaves, setControlLlaves] = useState([
    { id: '1', llave: 'Llave Cuarto de Bombas Sótano 2', prestadoA: 'Carlos Técnico (Schindler)', estado: 'Prestada', horaSalida: '10:00 AM' }
  ]);

  // Pases QR generados por los residentes para que el vigilante los valide
  const [pasesQRResidente, setPasesQRResidente] = useState([
    { id: '1', visitante: 'Maria Gomez', cedula: '43281920', fecha: '2026-10-25', codigoQR: 'URBIX-QR-8842', estado: 'Activo' }
  ]);

  const [alertaPanico, setAlertaPanico] = useState(false);

  // Funciones de Negocio
  const registrarNuevoPaquete = (e) => {
    e.preventDefault();
    const destino = e.target.destinoPaq.value;
    const empresa = e.target.empresaPaq.value;
    const desc = e.target.descPaq.value;

    const nuevo = {
      id: Date.now().toString(),
      destino,
      empresa,
      descripcion: desc,
      fotoLlegada: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=300&q=80',
      estado: 'En Custodia',
      fechaLlegada: new Date().toLocaleString(),
      recibidoPorResidente: null,
      firmaResidente: null
    };

    setPaquetesBlindados([nuevo, ...paquetesBlindados]);
    e.target.reset();
  };

  const entregarPaqueteConFirma = (id, nombreReceptor) => {
    setPaquetesBlindados(paquetesBlindados.map(p => {
      if (p.id === id) {
        return {
          ...p,
          estado: 'Entregado',
          recibidoPorResidente: nombreReceptor || 'Residente Autorizado',
          firmaResidente: 'Firmado Digitalmente'
        };
      }
      return p;
    }));
  };

  const generarPaseQRResidente = (e) => {
    e.preventDefault();
    const visitante = e.target.nomVisRes.value;
    const cedula = e.target.cedVisRes.value;
    const fecha = e.target.fechVisRes.value;

    const nuevoPase = {
      id: Date.now().toString(),
      visitante,
      cedula,
      fecha,
      codigoQR: `URBIX-QR-${Math.floor(1000 + Math.random() * 9000)}`,
      estado: 'Activo'
    };

    setPasesQRResidente([nuevoPase, ...pasesQRResidente]);
    e.target.reset();
    alert("¡Pase QR generado con éxito para compartir con su visitante!");
  };

  return (
    <div className="min-h-screen bg-[#141416] text-gray-200 font-sans flex flex-col">
      
      {/* 🛡️ BARRA SUPERIOR UNIFICADA (SIN DUPLICIDADES NI LANDING) */}
      <header className="bg-[#1c1c1f] border-b border-[#262629] px-6 py-4 flex items-center justify-between sticky top-0 z-50">
        <div className="flex items-center space-x-3">
          <div className="bg-cyan-500/10 p-2 rounded-lg border border-cyan-500/30">
            <Building2 className="w-6 h-6 text-cyan-400" />
          </div>
          <div>
            <h1 className="text-lg font-bold tracking-tight text-white flex items-center gap-2">
              URBIX PH <span className="text-xs px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 font-mono">Versión 3.0 Unificada</span>
            </h1>
            <p className="text-xs text-gray-400">Sistema Integral de Propiedad Horizontal • Ley 675</p>
          </div>
        </div>

        {/* SELECTOR DE ROLES ÚNICO */}
        <div className="flex items-center space-x-2 bg-[#141416] p-1.5 rounded-xl border border-[#262629]">
          <button onClick={() => setCurrentRole('admin')} className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${currentRole === 'admin' ? 'bg-cyan-500 text-black font-bold' : 'text-gray-400 hover:text-white'}`}>💼 Administrador</button>
          <button onClick={() => setCurrentRole('supervisor')} className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${currentRole === 'supervisor' ? 'bg-cyan-500 text-black font-bold' : 'text-gray-400 hover:text-white'}`}>⚡ Supervisor</button>
          <button onClick={() => setCurrentRole('vigilante')} className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${currentRole === 'vigilante' ? 'bg-cyan-500 text-black font-bold' : 'text-gray-400 hover:text-white'}`}>🚨 Consola Vigilante</button>
          <button onClick={() => setCurrentRole('residente')} className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${currentRole === 'residente' ? 'bg-cyan-500 text-black font-bold' : 'text-gray-400 hover:text-white'}`}>👤 Portal Residente</button>
        </div>

        {/* ESTADO REALTIME / SOS */}
        <div className="flex items-center space-x-3">
          {alertaPanico && (
            <div className="bg-red-500/20 border border-red-500 text-red-400 px-3 py-1 rounded-lg text-xs font-bold animate-pulse flex items-center gap-1">
              <AlertOctagon className="w-4 h-4" /> ¡ALERTA SOS!
            </div>
          )}
          <div className="flex items-center gap-2 bg-[#141416] px-3 py-1.5 rounded-lg border border-[#262629]">
            <span className="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span className="text-xs font-mono text-emerald-400">Realtime Sincronizado</span>
          </div>
        </div>
      </header>

      {/* CONTENIDO PRINCIPAL */}
      <main className="flex-1 p-6 max-w-7xl mx-auto w-full">
        
        {/* ========================================== */}
        {/* ROL 1: ADMINISTRADOR                       */}
        {/* ========================================== */}
        {currentRole === 'admin' && (
          <div className="space-y-6">
            <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
              <h2 className="text-xl font-bold text-white mb-2">Panel del Administrador (Ley 675)</h2>
              <p className="text-xs text-gray-400">Gestión financiera, cartera y control de unidades residenciales.</p>
            </div>
            <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
              <h3 className="text-md font-semibold text-white mb-4">Unidades y Cartera en Vivo</h3>
              <div className="space-y-2 font-mono text-xs">
                {unidades.map(u => (
                  <div key={u.id} className="flex justify-between items-center bg-[#141416] p-3 rounded-xl border border-[#262629]">
                    <span className="font-bold text-white">{u.numero} - {u.propietario}</span>
                    <span className="text-red-400">Deuda: $ {u.saldo.toLocaleString()}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* ========================================== */}
        {/* ROL 2: SUPERVISOR                          */}
        {/* ========================================== */}
        {currentRole === 'supervisor' && (
          <div className="space-y-6">
            <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
              <h2 className="text-xl font-bold text-white mb-2">Panel del Supervisor Operativo</h2>
              <p className="text-xs text-gray-400">Auditoría en terreno, caja menor y control de cuadrillas.</p>
            </div>
          </div>
        )}

        {/* ========================================== */}
        {/* ROL 3: CONSOLA INTEGRAL DEL VIGILANTE      */}
        {/* ========================================== */}
        {currentRole === 'vigilante' && (
          <div className="space-y-6">
            <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629] flex justify-between items-center">
              <div>
                <h2 className="text-xl font-bold text-white">Consola de Portería & Vigilancia (Todo en Uno)</h2>
                <p className="text-xs text-gray-400">Paquetería con foto/firma, validación de Pases QR de residentes, control de llaves y rondas.</p>
              </div>
              <button onClick={() => setAlertaPanico(!alertaPanico)} className={`px-4 py-2 rounded-xl text-xs font-bold transition-all ${alertaPanico ? 'bg-red-600 text-white animate-bounce' : 'bg-red-500/20 text-red-400 border border-red-500/40 hover:bg-red-500 hover:text-white'}`}>
                🚨 {alertaPanico ? 'EMERGENCIA ACTIVA' : 'BOTÓN DE PÁNICO SOS'}
              </button>
            </div>

            {/* SUB-PESTAÑAS INTERNAS DE LA CONSOLA DEL VIGILANTE */}
            <div className="flex gap-2 border-b border-[#262629] pb-3">
              <button onClick={() => setActiveTabVigilante('paquetes')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabVigilante === 'paquetes' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>📦 Paquetería Blindada (Fotos & Firmas)</button>
              <button onClick={() => setActiveTabVigilante('qr')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabVigilante === 'qr' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>📱 Validador de Pases QR</button>
              <button onClick={() => setActiveTabVigilante('llaves')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabVigilante === 'llaves' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>🔑 Préstamo de Llaves</button>
              <button onClick={() => setActiveTabVigilante('visitantes')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabVigilante === 'visitantes' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>👥 Visitantes & Accesos</button>
            </div>

            {/* 1. PAQUETERÍA BLINDADA */}
            {activeTabVigilante === 'paquetes' && (
              <div className="space-y-6">
                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4 flex items-center gap-2">
                    <Camera className="w-5 h-5 text-cyan-400" /> Registrar Llegada de Paquete (Evidencia Fotográfica)
                  </h3>
                  <form onSubmit={registrarNuevoPaquete} className="grid grid-cols-1 md:grid-cols-4 gap-3">
                    <input name="destinoPaq" type="text" placeholder="Apartamento (Ej. Torre 2 - 301)" required className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <input name="empresaPaq" type="text" placeholder="Empresa (Servientrega, Amazon...)" required className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <input name="descPaq" type="text" placeholder="Descripción (Caja, Sobre...)" required className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <button type="submit" className="bg-cyan-500 text-black font-bold px-4 py-2 rounded-xl text-xs hover:bg-cyan-400 flex items-center justify-center gap-2">
                      <Camera className="w-4 h-4" /> Tomar Foto & Recibir
                    </button>
                  </form>
                </div>

                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4">Custodia y Entrega con Firma Digital</h3>
                  <div className="space-y-4">
                    {paquetesBlindados.map(pq => (
                      <div key={pq.id} className="bg-[#141416] p-4 rounded-xl border border-[#262629] flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div className="flex items-center gap-4">
                          <img src={pq.fotoLlegada} alt="Evidencia Paquete" className="w-16 h-16 rounded-lg object-cover border border-[#262629]" />
                          <div>
                            <p className="font-bold text-white text-sm">Destino: {pq.destino}</p>
                            <p className="text-xs text-gray-400 font-mono">{pq.empresa} - {pq.descripcion}</p>
                            <p className="text-[10px] text-gray-500 font-mono mt-1">Llegada: {pq.fechaLlegada}</p>
                            {pq.estado === 'Entregado' && (
                              <p className="text-[10px] text-emerald-400 font-mono mt-1">Entregado a: {pq.recibidoPorResidente} | {pq.firmaResidente}</p>
                            )}
                          </div>
                        </div>

                        <div>
                          {pq.estado === 'En Custodia' ? (
                            <button onClick={() => {
                              const receptor = prompt("Nombre de la persona que retira el paquete:");
                              if(receptor) entregarPaqueteConFirma(pq.id, receptor);
                            }} className="bg-emerald-500 text-black font-bold px-4 py-2 rounded-xl text-xs hover:bg-emerald-400 flex items-center gap-2">
                              <ShieldCheck className="w-4 h-4" /> Entregar con Firma Digital
                            </button>
                          ) : (
                            <span className="px-3 py-1 rounded bg-emerald-500/20 text-emerald-400 font-bold text-xs font-mono">
                              🟢 Entregado Correctamente
                            </span>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {/* 2. VALIDADOR DE PASES QR DE RESIDENTES */}
            {activeTabVigilante === 'qr' && (
              <div className="space-y-6">
                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-2 flex items-center gap-2">
                    <QrCode className="w-5 h-5 text-cyan-400" /> Escanear o Ingresar Código QR del Visitante
                  </h3>
                  <p className="text-xs text-gray-400 mb-4">Valida en tiempo real los pases de acceso generados por los propietarios.</p>
                  <div className="flex gap-3">
                    <input id="inputCodigoQR" type="text" placeholder="Ingrese Código QR (Ej. URBIX-QR-8842)" className="flex-1 bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <button onClick={() => {
                      const val = document.getElementById('inputCodigoQR').value;
                      const encontrado = pasesQRResidente.find(p => p.codigoQR === val);
                      if(encontrado) {
                        alert(`🟢 ACCESO AUTORIZADO: Visitante ${encontrado.visitante} (Cédula: ${encontrado.cedula})`);
                      } else {
                        alert(`🔴 CÓDIGO QR INVÁLIDO O EXPIRADO`);
                      }
                    }} className="bg-cyan-500 text-black font-bold px-6 py-2 rounded-xl text-xs hover:bg-cyan-400">
                      Validar QR en Puerta
                    </button>
                  </div>
                </div>

                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4">Pases Activos en el Sistema (Generados por Residentes)</h3>
                  <div className="space-y-2 font-mono text-xs">
                    {pasesQRResidente.map(p => (
                      <div key={p.id} className="flex justify-between items-center bg-[#141416] p-3 rounded-xl border border-[#262629]">
                        <div>
                          <p className="font-bold text-white">Visitante: {p.visitante} (Céd. {p.cedula})</p>
                          <p className="text-gray-400">Código: {p.codigoQR} | Fecha: {p.fecha}</p>
                        </div>
                        <span className="px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-400 font-bold">{p.estado}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {/* 3. PRÉSTAMO DE LLAVES */}
            {activeTabVigilante === 'llaves' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                <h3 className="text-md font-semibold text-white mb-4 flex items-center gap-2">
                  <Key className="w-5 h-5 text-cyan-400" /> Control de Préstamo de Llaves
                </h3>
                <div className="space-y-3 font-mono text-xs">
                  {controlLlaves.map(ll => (
                    <div key={ll.id} className="flex justify-between items-center bg-[#141416] p-4 rounded-xl border border-[#262629]">
                      <div>
                        <p className="font-bold text-white text-sm">{ll.llave}</p>
                        <p className="text-gray-400">Prestado a: {ll.prestadoA} | Hora: {ll.horaSalida}</p>
                      </div>
                      <span className="px-3 py-1 rounded bg-amber-500/20 text-amber-400 font-bold">{ll.estado}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* 4. VISITANTES */}
            {activeTabVigilante === 'visitantes' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                <h3 className="text-md font-semibold text-white mb-4">Visitantes Adentro</h3>
                <div className="space-y-2 font-mono text-xs">
                  {accesosPorteria.map(a => (
                    <div key={a.id} className="flex justify-between items-center bg-[#141416] p-3 rounded-xl border border-[#262629]">
                      <span className="font-bold text-white">{a.visitante} - Destino: {a.destino}</span>
                      <span className="px-2 py-1 rounded bg-emerald-500/20 text-emerald-400 font-bold">{a.estado}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        )}

        {/* ========================================== */}
        {/* ROL 4: PORTAL DEL RESIDENTE (MÓDULO 6)     */}
        {/* ========================================== */}
        {currentRole === 'residente' && (
          <div className="space-y-6">
            <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629] flex justify-between items-center">
              <div>
                <h2 className="text-xl font-bold text-white">Portal del Propietario / Residente (Torre 2 - 301)</h2>
                <p className="text-xs text-gray-400">Generación de pases QR para visitantes y visualización de paquetes en custodia.</p>
              </div>
              <span className="px-3 py-1 rounded bg-emerald-500/20 text-emerald-400 font-mono text-xs font-bold">🟢 Paz y Salvo Vigente</span>
            </div>

            {/* SUB-PESTAÑAS PORTAL RESIDENTE */}
            <div className="flex gap-2 border-b border-[#262629] pb-3">
              <button onClick={() => setActiveTabResidente('qr')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabResidente === 'qr' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>📱 Generar Pase QR para Visitante</button>
              <button onClick={() => setActiveTabResidente('mispaquetes')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabResidente === 'mispaquetes' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>📦 Mis Paquetes en Portería</button>
            </div>

            {activeTabResidente === 'qr' && (
              <div className="space-y-6">
                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4 flex items-center gap-2">
                    <QrCode className="w-5 h-5 text-cyan-400" /> Crear Autorización y Pase QR Rápido
                  </h3>
                  <form onSubmit={generarPaseQRResidente} className="grid grid-cols-1 md:grid-cols-4 gap-3">
                    <input name="nomVisRes" type="text" placeholder="Nombre del Visitante" required className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <input name="cedVisRes" type="text" placeholder="Cédula" required className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <input name="fechVisRes" type="date" required className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <button type="submit" className="bg-cyan-500 text-black font-bold px-4 py-2 rounded-xl text-xs hover:bg-cyan-400">
                      Generar Pase QR
                    </button>
                  </form>
                </div>

                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4">Mis Pases Generados</h3>
                  <div className="space-y-2 font-mono text-xs">
                    {pasesQRResidente.map(p => (
                      <div key={p.id} className="flex justify-between items-center bg-[#141416] p-3 rounded-xl border border-[#262629]">
                        <div>
                          <p className="font-bold text-white">Visitante: {p.visitante} | Código: <span className="text-cyan-400">{p.codigoQR}</span></p>
                          <p className="text-gray-400">Fecha autorizada: {p.fecha}</p>
                        </div>
                        <button onClick={() => alert(`Enlace de WhatsApp simulado para el pase ${p.codigoQR} copiado al portapapeles.`)} className="bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 px-3 py-1 rounded-lg font-bold flex items-center gap-1">
                          <Share2 className="w-3 h-3" /> Compartir WhatsApp
                        </button>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {activeTabResidente === 'mispaquetes' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                <h3 className="text-md font-semibold text-white mb-4">Paquetes a nombre de Torre 2 - 301</h3>
                <div className="space-y-3">
                  {paquetesBlindados.filter(pq => pq.destino.includes('301')).map(pq => (
                    <div key={pq.id} className="bg-[#141416] p-4 rounded-xl border border-[#262629] flex items-center gap-4 font-mono text-xs">
                      <img src={pq.fotoLlegada} alt="Paquete" className="w-14 h-14 rounded-lg object-cover border border-[#262629]" />
                      <div>
                        <p className="font-bold text-white text-sm">{pq.empresa} - {pq.descripcion}</p>
                        <p className="text-gray-400">Llegada: {pq.fechaLlegada} | Estado: <span className="text-amber-400">{pq.estado}</span></p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        )}

      </main>
    </div>
  );
}