import React, { useState, useEffect } from 'react';
import { 
  Shield, Building2, Users, FileText, DollarSign, Wrench, 
  AlertTriangle, CheckCircle, Clock, Search, Plus, Trash2, 
  Edit, ArrowRight, Activity, Database, Lock, Unlock, LogOut,
  Bell, Eye, Check, X, Phone, Truck, Package, MapPin, Radio,
  Camera, AlertOctagon, RefreshCw, BarChart2
} from 'lucide-react';

// ==========================================
// URBIX PH - APLICACIÓN MONOLÍTICA UNIFICADA
// (Superadmin, Admin, Supervisor, Vigilante)
// ==========================================

export default function UrbixPHApp() {
  // Estado Global de Navegación y Roles (ARRANQUE DIRECTO - SIN LANDING PAGE)
  const [currentRole, setCurrentRole] = useState('admin'); // 'superadmin', 'admin', 'supervisor', 'vigilante'
  const [activeTabAdmin, setActiveTabAdmin] = useState('cartera'); // 'cartera', 'egresos', 'personal', 'multas'
  const [activeTabSupervisor, setActiveTabSupervisor] = useState('caja'); // 'caja', 'cuadrillas', 'rondas'
  const [activeTabVigilante, setActiveTabVigilante] = useState('visitantes'); // 'visitantes', 'paquetes', 'contratistas', 'ronda'

  // Estados Compartidos (Simulación de Base de Datos Global + Realtime)
  const [unidades, setUnidades] = useState([
    { id: '1', numero: 'Torre 1 - 101', propietario: 'Carlos Pérez', coeficiente: 0.0125, cuota: 450000, saldo: 0, cartera: 'Al día' },
    { id: '2', numero: 'Torre 1 - 202', propietario: 'Ana María Gómez', coeficiente: 0.0150, cuota: 540000, saldo: 1080000, cartera: 'Mora 60' },
    { id: '3', numero: 'Torre 2 - 301', propietario: 'Esteban Ochoa', coeficiente: 0.0125, cuota: 450000, saldo: 450000, cartera: 'Mora 30' },
    { id: '4', numero: 'Torre 2 - 402', propietario: 'Sofía Restrepo', coeficiente: 0.0200, cuota: 720000, saldo: 0, cartera: 'Al día' },
  ]);

  const [recaudos, setRecaudos] = useState([
    { id: '1', unidad: 'Torre 1 - 101', monto: 450000, concepto: 'Cuota Ordinaria Octubre', ref: 'CUS-98312', estado: 'Aprobado', fecha: '2026-10-01' },
    { id: '2', unidad: 'Torre 2 - 402', monto: 720000, concepto: 'Cuota Ordinaria Octubre', ref: 'CUS-98455', estado: 'Aprobado', fecha: '2026-10-02' }
  ]);

  const [egresos, setEgresos] = useState([
    { id: '1', proveedor: 'Seguridad El Poblado LTDA', nit: '900.123.456-1', categoria: 'Vigilancia', monto: 12500000, estado: 'Pagado' },
    { id: '2', proveedor: 'EPM (Agua y Energía)', nit: '890.904.996-1', categoria: 'EPM', monto: 4800000, estado: 'Pendiente' }
  ]);

  const [cajaMenor, setCajaMenor] = useState([
    { id: '1', concepto: 'Compra de 4 bombillos LED pasillo Torre 1', ferreteria: 'Ferretería El Diamante', monto: 85000, estado: 'Registrado en Caja Menor' }
  ]);

  const [personal, setPersonal] = useState([
    { id: '1', nombre: 'Roberto Sánchez', rol: 'vigilante', turno: 'Diurno 6am-2pm', arl: 'Vigente' },
    { id: '2', nombre: 'Luz Dary Marín', rol: 'aseo', turno: 'Diurno 7am-3pm', arl: 'Vigente' },
    { id: '3', nombre: 'Ascensores Schindler S.A.', rol: 'contratista', turno: 'Orden de Trabajo', arl: 'Vigente' }
  ]);

  const [auditLogs, setAuditLogs] = useState([
    { id: '1', accion: 'Conciliación de Pago', ejecutor: 'Supervisor', modulo: 'Tab 4.1', fecha: '2026-10-24 10:30' },
    { id: '2', accion: 'Apertura de Módulo Admin', ejecutor: 'Administrador', modulo: 'Tab 3.1', fecha: '2026-10-24 09:15' }
  ]);

  const [accesosPorteria, setAccesosPorteria] = useState([
    { id: '1', visitante: 'Juan Carlos Mesa', cedula: '10389234', destino: 'Torre 1 - 101', motivo: 'Visita', vehiculo: 'Carro (V-01)', estado: 'Adentro' }
  ]);

  const [paquetes, setPaquetes] = useState([
    { id: '1', destino: 'Torre 2 - 301', empresa: 'Servientrega', descripcion: 'Caja Amazon', estado: 'En Portería' }
  ]);

  const [rondas, setRondas] = useState([
    { id: '1', checkpoint: 'Perímetro y Cerramiento Norte', estado: 'Sin Novedad', hora: '06:00 AM' },
    { id: '2', checkpoint: 'Sótano 2 - Cuarto de Bombas', estado: 'Hallazgo Menor', hora: '06:15 AM' }
  ]);

  const [alertaPanico, setAlertaPanico] = useState(false);

  // Funciones de Negocio y Puentes en Tiempo Real
  const aprobarPagoSupervisor = (id) => {
    // Simula conciliación
    setRecaudos(recaudos.map(r => r.id === id ? { ...r, estado: 'Aprobado' } : r));
    setAuditLogs([{ id: Date.now().toString(), accion: 'Pago Conciliado en Sitio', ejecutor: 'Supervisor', modulo: 'Tab 4.1', fecha: new Date().toLocaleString() }, ...auditLogs]);
  };

  const registrarGastoCajaMenor = (concepto, monto) => {
    const nuevoGasto = { id: Date.now().toString(), concepto, ferreteria: 'Ferretería Local', monto: parseFloat(monto), estado: 'Registrado en Caja Menor' };
    setCajaMenor([nuevoGasto, ...cajaMenor]);
    // Puente automático con egresos del admin
    setEgresos([{ id: Date.now().toString(), proveedor: 'Caja Menor Operativa', nit: 'N/A', categoria: 'Caja Menor', monto: parseFloat(monto), estado: 'Avalado por Supervisor' }, ...egresos]);
    setAuditLogs([{ id: Date.now().toString(), accion: `Gasto Caja Menor: ${concepto}`, ejecutor: 'Supervisor', modulo: 'Tab 4.1', fecha: new Date().toLocaleString() }, ...auditLogs]);
  };

  const registrarVisitaPorteria = (visitante, cedula, destino, motivo, vehiculo) => {
    const nuevo = { id: Date.now().toString(), visitante, cedula, destino, motivo, vehiculo, estado: 'Adentro' };
    setAccesosPorteria([nuevo, ...accesosPorteria]);
  };

  const registrarCheckRonda = (checkpoint, estado, obs) => {
    const nuevaRonda = { id: Date.now().toString(), checkpoint, estado, hora: new Date().toLocaleTimeString() };
    setRondas([nuevaRonda, ...rondas]);
    if (estado.includes('Incidente')) {
      setAuditLogs([{ id: Date.now().toString(), accion: `Incidente en Ronda: ${checkpoint} - ${obs}`, ejecutor: 'Vigilante (Ronda)', modulo: 'Tab 4.3', fecha: new Date().toLocaleString() }, ...auditLogs]);
    }
  };

  return (
    <div className="min-h-screen bg-[#141416] text-gray-200 font-sans flex flex-col">
      
      {/* BARRA SUPERIOR DE NAVEGACIÓN GLOBAL (SELECTOR DE ROLES) */}
      <header className="bg-[#1c1c1f] border-b border-[#262629] px-6 py-4 flex items-center justify-between sticky top-0 z-50">
        <div className="flex items-center space-x-3">
          <div className="bg-cyan-500/10 p-2 rounded-lg border border-cyan-500/30">
            <Building2 className="w-6 h-6 text-cyan-400" />
          </div>
          <div>
            <h1 className="text-lg font-bold tracking-tight text-white flex items-center gap-2">
              URBIX PH <span className="text-xs px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 font-mono">Ley 675 Colombia</span>
            </h1>
            <p className="text-xs text-gray-400">Sistema Integral de Propiedad Horizontal • Neo-Swiss Engine</p>
          </div>
        </div>

        {/* SELECTOR DE ROLES PRINCIPALES */}
        <div className="flex items-center space-x-2 bg-[#141416] p-1.5 rounded-xl border border-[#262629]">
          <button 
            onClick={() => setCurrentRole('superadmin')}
            className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${currentRole === 'superadmin' ? 'bg-cyan-500 text-black font-bold shadow-lg' : 'text-gray-400 hover:text-white'}`}
          >
            🛡️ Superadmin
          </button>
          <button 
            onClick={() => setCurrentRole('admin')}
            className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${currentRole === 'admin' ? 'bg-cyan-500 text-black font-bold shadow-lg' : 'text-gray-400 hover:text-white'}`}
          >
            💼 Administrador
          </button>
          <button 
            onClick={() => setCurrentRole('supervisor')}
            className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${currentRole === 'supervisor' ? 'bg-cyan-500 text-black font-bold shadow-lg' : 'text-gray-400 hover:text-white'}`}
          >
            ⚡ Supervisor
          </button>
          <button 
            onClick={() => setCurrentRole('vigilante')}
            className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${currentRole === 'vigilante' ? 'bg-cyan-500 text-black font-bold shadow-lg' : 'text-gray-400 hover:text-white'}`}
          >
            🚨 Portería & Ronda
          </button>
        </div>

        {/* INDICADOR DE ESTADO EN TIEMPO REAL */}
        <div className="flex items-center space-x-3">
          {alertaPanico && (
            <div className="bg-red-500/20 border border-red-500 text-red-400 px-3 py-1 rounded-lg text-xs font-bold animate-pulse flex items-center gap-1">
              <AlertOctagon className="w-4 h-4" /> ¡ALERTA SOS ACTIVA!
            </div>
          )}
          <div className="flex items-center gap-2 bg-[#141416] px-3 py-1.5 rounded-lg border border-[#262629]">
            <span className="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span className="text-xs font-mono text-emerald-400">Realtime Sincronizado</span>
          </div>
        </div>
      </header>

      {/* CONTENIDO SEGÚN EL ROL ACTIVO */}
      <main className="flex-1 p-6 max-w-7xl mx-auto w-full">
        
        {/* ========================================== */}
        {/* ROL 1: SUPERADMIN (MÓDULO 2)               */}
        {/* ========================================== */}
        {currentRole === 'superadmin' && (
          <div className="space-y-6">
            <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
              <h2 className="text-xl font-bold text-white mb-2">Módulo 2: Superadmin RBAC & Auditoría Global</h2>
              <p className="text-sm text-gray-400">Control maestro de roles del sistema y registro inmutable de trazabilidad.</p>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div className="bg-[#1c1c1f] p-5 rounded-xl border border-[#262629]">
                <p className="text-xs text-gray-400 font-mono">Total Registros Auditados</p>
                <p className="text-3xl font-bold font-mono text-cyan-400 mt-1">{auditLogs.length}</p>
              </div>
              <div className="bg-[#1c1c1f] p-5 rounded-xl border border-[#262629]">
                <p className="text-xs text-gray-400 font-mono">Usuarios del Sistema</p>
                <p className="text-3xl font-bold font-mono text-emerald-400 mt-1">{personal.length + 2}</p>
              </div>
              <div className="bg-[#1c1c1f] p-5 rounded-xl border border-[#262629]">
                <p className="text-xs text-gray-400 font-mono">Estado de Seguridad</p>
                <p className="text-xl font-bold font-mono text-emerald-400 mt-1">Blindado (Ley 675)</p>
              </div>
            </div>
            <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
              <h3 className="text-md font-semibold text-white mb-4">Registro Inmutable de Auditoría (Audit Logs)</h3>
              <div className="space-y-2">
                {auditLogs.map((log) => (
                  <div key={log.id} className="flex justify-between items-center bg-[#141416] p-3 rounded-lg border border-[#262629] text-xs font-mono">
                    <span className="text-cyan-400">{log.accion}</span>
                    <span className="text-gray-300">Ejecutor: {log.ejecutor} ({log.modulo})</span>
                    <span className="text-gray-500">{log.fecha}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* ========================================== */}
        {/* ROL 2: ADMINISTRADOR (MÓDULO 3)            */}
        {/* ========================================== */}
        {currentRole === 'admin' && (
          <div className="space-y-6">
            {/* SUB-NAVEGACIÓN ADMIN */}
            <div className="flex gap-2 border-b border-[#262629] pb-3">
              <button onClick={() => setActiveTabAdmin('cartera')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabAdmin === 'cartera' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>3.1 Cartera & Recaudo</button>
              <button onClick={() => setActiveTabAdmin('egresos')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabAdmin === 'egresos' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>3.2 Egresos & Proveedores</button>
              <button onClick={() => setActiveTabAdmin('personal')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabAdmin === 'personal' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>3.3 Personal & Contratistas</button>
              <button onClick={() => setActiveTabAdmin('multas')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabAdmin === 'multas' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>3.4 Convivencia & Consejo</button>
            </div>

            {/* TAB 3.1: CARTERA */}
            {activeTabAdmin === 'cartera' && (
              <div className="space-y-6">
                <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                  <div className="bg-[#1c1c1f] p-5 rounded-xl border border-[#262629]">
                    <p className="text-xs text-gray-400 font-mono">Recaudo Total del Mes</p>
                    <p className="text-2xl font-bold font-mono text-emerald-400 mt-1">$ 1.170.000 COP</p>
                  </div>
                  <div className="bg-[#1c1c1f] p-5 rounded-xl border border-[#262629]">
                    <p className="text-xs text-gray-400 font-mono">Cartera Morosa Total</p>
                    <p className="text-2xl font-bold font-mono text-red-400 mt-1">$ 1.530.000 COP</p>
                  </div>
                  <div className="bg-[#1c1c1f] p-5 rounded-xl border border-[#262629]">
                    <p className="text-xs text-gray-400 font-mono">Unidades al Día</p>
                    <p className="text-2xl font-bold font-mono text-cyan-400 mt-1">50% (2/4 Unidades)</p>
                  </div>
                </div>

                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4">Tabla Maestra de Unidades (Kardex Financiero)</h3>
                  <div className="overflow-x-auto">
                    <table className="w-full text-left text-xs font-mono">
                      <thead>
                        <tr className="border-b border-[#262629] text-gray-400">
                          <th className="pb-3">Unidad</th>
                          <th className="pb-3">Propietario</th>
                          <th className="pb-3">Coeficiente</th>
                          <th className="pb-3">Cuota Mensual</th>
                          <th className="pb-3">Saldo Actual</th>
                          <th className="pb-3">Estado Cartera</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-[#262629]">
                        {unidades.map(u => (
                          <tr key={u.id} className="hover:bg-[#262629]/50">
                            <td className="py-3 font-bold text-white">{u.numero}</td>
                            <td className="py-3 text-gray-300">{u.propietario}</td>
                            <td className="py-3">{u.coeficiente}</td>
                            <td className="py-3">$ {u.cuota.toLocaleString()}</td>
                            <td className="py-3 font-bold text-red-400">$ {u.saldo.toLocaleString()}</td>
                            <td className="py-3"><span className={`px-2 py-1 rounded text-[10px] font-bold ${u.cartera === 'Al día' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-red-500/20 text-red-400'}`}>{u.cartera}</span></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            )}

            {/* TAB 3.2: EGRESOS & PRESUPUESTO */}
            {activeTabAdmin === 'egresos' && (
              <div className="space-y-6">
                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4">Control de Egresos y Caja Menor en Vivo</h3>
                  <div className="space-y-3">
                    {egresos.map(e => (
                      <div key={e.id} className="flex justify-between items-center bg-[#141416] p-4 rounded-xl border border-[#262629]">
                        <div>
                          <p className="font-bold text-white text-sm">{e.proveedor}</p>
                          <p className="text-xs text-gray-400 font-mono">Categoría: {e.categoria} | NIT: {e.nit}</p>
                        </div>
                        <div className="text-right">
                          <p className="font-bold font-mono text-cyan-400">$ {e.monto.toLocaleString()} COP</p>
                          <span className={`text-[10px] px-2 py-0.5 rounded font-bold ${e.estado === 'Pagado' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-amber-500/20 text-amber-400'}`}>{e.estado}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {/* TAB 3.3: PERSONAL & CONTRATISTAS */}
            {activeTabAdmin === 'personal' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                <h3 className="text-md font-semibold text-white mb-4">Gestión de Personal Operativo</h3>
                <div className="space-y-3">
                  {personal.map(p => (
                    <div key={p.id} className="flex justify-between items-center bg-[#141416] p-4 rounded-xl border border-[#262629] font-mono text-xs">
                      <div>
                        <p className="font-bold text-white text-sm">{p.nombre}</p>
                        <p className="text-gray-400">Rol: {p.rol} | Turno: {p.turno}</p>
                      </div>
                      <span className="px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-400 font-bold">ARL: {p.arl}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* TAB 3.4: CONVIVENCIA & CONSEJO */}
            {activeTabAdmin === 'multas' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                <h3 className="text-md font-semibold text-white mb-2">Informe Ejecutivo para el Consejo de Administración</h3>
                <p className="text-xs text-gray-400 mb-4">Consolidado automático bajo Ley 675 listo para presentación.</p>
                <div className="bg-[#141416] p-4 rounded-xl border border-[#262629] space-y-2 text-xs font-mono">
                  <p className="text-cyan-400 font-bold">📊 Estado Financiero Consolidado:</p>
                  <p>• Recaudos del Mes: $ 1.170.000 COP</p>
                  <p>• Cartera en Mora: $ 1.530.000 COP</p>
                  <p>• Novedades de Convivencia y Rondas: Sin multas críticas pendientes.</p>
                </div>
              </div>
            )}
          </div>
        )}

        {/* ========================================== */}
        {/* ROL 3: SUPERVISOR (MÓDULO 4)               */}
        {/* ========================================== */}
        {currentRole === 'supervisor' && (
          <div className="space-y-6">
            <div className="flex gap-2 border-b border-[#262629] pb-3">
              <button onClick={() => setActiveTabSupervisor('caja')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabSupervisor === 'caja' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>Tab 4.1: Caja Menor & Pagos</button>
              <button onClick={() => setActiveTabSupervisor('cuadrillas')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabSupervisor === 'cuadrillas' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>Tab 4.2: Cuadrillas & ARL</button>
              <button onClick={() => setActiveTabSupervisor('rondas')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabSupervisor === 'rondas' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>Tab 4.3: Bitácora & Rondas</button>
            </div>

            {/* TAB 4.1: CAJA MENOR & CONCILIACIÓN */}
            {activeTabSupervisor === 'caja' && (
              <div className="space-y-6">
                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4">Bandeja de Conciliación de Pagos (En vivo con Admin)</h3>
                  <div className="space-y-3">
                    {recaudos.map(r => (
                      <div key={r.id} className="flex justify-between items-center bg-[#141416] p-4 rounded-xl border border-[#262629] font-mono text-xs">
                        <div>
                          <p className="font-bold text-white text-sm">{r.unidad}</p>
                          <p className="text-gray-400">{r.concepto} - Ref: {r.ref}</p>
                        </div>
                        <div className="flex items-center gap-3">
                          <span className="font-bold text-cyan-400">$ {r.monto.toLocaleString()}</span>
                          <button onClick={() => aprobarPagoSupervisor(r.id)} className="bg-emerald-500 text-black px-3 py-1.5 rounded-lg font-bold hover:bg-emerald-400">
                            ✅ Conciliar Pago
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4">Registro Rápido de Caja Menor (Urgencias)</h3>
                  <div className="flex gap-3">
                    <input id="conceptoGasto" type="text" placeholder="Concepto (Ej. Compra bombillos)" className="flex-1 bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <input id="montoGasto" type="number" placeholder="Monto COP" className="w-32 bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <button onClick={() => {
                      const c = document.getElementById('conceptoGasto').value;
                      const m = document.getElementById('montoGasto').value;
                      if(c && m) registrarGastoCajaMenor(c, m);
                    }} className="bg-cyan-500 text-black font-bold px-4 py-2 rounded-xl text-xs hover:bg-cyan-400">
                      Registrar Gasto
                    </button>
                  </div>
                </div>
              </div>
            )}

            {/* TAB 4.2: CUADRILLAS & CONTRATISTAS */}
            {activeTabSupervisor === 'cuadrillas' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                <h3 className="text-md font-semibold text-white mb-4">Control de Asistencia y ARL en Terreno</h3>
                <div className="space-y-3 font-mono text-xs">
                  {personal.map(p => (
                    <div key={p.id} className="flex justify-between items-center bg-[#141416] p-4 rounded-xl border border-[#262629]">
                      <div>
                        <p className="font-bold text-white text-sm">{p.nombre}</p>
                        <p className="text-gray-400">Rol: {p.rol} | Turno: {p.turno}</p>
                      </div>
                      <span className="px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-400 font-bold">🟢 En Puesto (ARL: {p.arl})</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* TAB 4.3: BITÁCORA & RONDAS */}
            {activeTabSupervisor === 'rondas' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                <h3 className="text-md font-semibold text-white mb-4">Bitácora de Rondas y Novedades del Edificio</h3>
                <div className="space-y-2 font-mono text-xs">
                  {rondas.map(rd => (
                    <div key={rd.id} className="flex justify-between items-center bg-[#141416] p-3 rounded-xl border border-[#262629]">
                      <span className="text-cyan-400 font-bold">{rd.checkpoint}</span>
                      <span className="text-gray-300">{rd.estado}</span>
                      <span className="text-gray-500">{rd.hora}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}

        {/* ========================================== */}
        {/* ROL 4: VIGILANTE / PORTERÍA & RONDA (MÓD. 5) */}
        {/* ========================================== */}
        {currentRole === 'vigilante' && (
          <div className="space-y-6">
            <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629] flex justify-between items-center">
              <div>
                <h2 className="text-xl font-bold text-white">Consola de Portería & Rondas ("Todo en Uno")</h2>
                <p className="text-xs text-gray-400">Control de acceso, paquetería y rondas perimetrales con botón SOS.</p>
              </div>
              <button onClick={() => setAlertaPanico(!alertaPanico)} className={`px-4 py-2 rounded-xl text-xs font-bold transition-all ${alertaPanico ? 'bg-red-600 text-white animate-bounce' : 'bg-red-500/20 text-red-400 border border-red-500/40 hover:bg-red-500 hover:text-white'}`}>
                🚨 {alertaPanico ? 'EMERGENCIA ACTIVA' : 'ACTIVAR BOTÓN DE PÁNICO SOS'}
              </button>
            </div>

            {/* SUB-PESTAÑAS VIGILANTE */}
            <div className="flex gap-2 border-b border-[#262629] pb-3">
              <button onClick={() => setActiveTabVigilante('visitantes')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabVigilante === 'visitantes' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>Control de Visitantes & Parqueaderos</button>
              <button onClick={() => setActiveTabVigilante('paquetes')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabVigilante === 'paquetes' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>Paquetería & Correspondencia</button>
              <button onClick={() => setActiveTabVigilante('contratistas')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabVigilante === 'contratistas' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>Contratistas & Herramientas</button>
              <button onClick={() => setActiveTabVigilante('ronda')} className={`px-4 py-2 rounded-lg text-sm font-medium ${activeTabVigilante === 'ronda' ? 'bg-[#1c1c1f] text-cyan-400 border border-[#262629]' : 'text-gray-400'}`}>🚀 Modo Ronda de Perímetro</button>
            </div>

            {/* VISTA VISITANTES */}
            {activeTabVigilante === 'visitantes' && (
              <div className="space-y-6">
                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4">Registrar Ingreso de Visitante / Vehículo</h3>
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <input id="nomVis" type="text" placeholder="Nombre Visitante" className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <input id="cedVis" type="text" placeholder="Cédula" className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                    <input id="destVis" type="text" placeholder="Apto a Visitar (Ej. 301)" className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white" />
                  </div>
                  <div className="flex gap-3 mt-3">
                    <select id="motVis" className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white flex-1">
                      <option>Visita Familiar</option>
                      <option>Domicilio / Rappi</option>
                      <option>Taxi</option>
                      <option>Proveedor / Contratista</option>
                    </select>
                    <input id="vehVis" type="text" placeholder="Placa Vehículo o Celda (Opcional)" className="bg-[#141416] border border-[#262629] rounded-xl px-4 py-2 text-xs font-mono text-white flex-1" />
                    <button onClick={() => {
                      const n = document.getElementById('nomVis').value;
                      const c = document.getElementById('cedVis').value;
                      const d = document.getElementById('destVis').value;
                      const m = document.getElementById('motVis').value;
                      const v = document.getElementById('vehVis').value;
                      if(n && d) registrarVisitaPorteria(n, c, d, m, v);
                    }} className="bg-cyan-500 text-black font-bold px-6 py-2 rounded-xl text-xs hover:bg-cyan-400">
                      Registrar Ingreso
                    </button>
                  </div>
                </div>

                <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                  <h3 className="text-md font-semibold text-white mb-4">Visitantes Adentro en este Momento</h3>
                  <div className="space-y-2 font-mono text-xs">
                    {accesosPorteria.map(a => (
                      <div key={a.id} className="flex justify-between items-center bg-[#141416] p-3 rounded-xl border border-[#262629]">
                        <div>
                          <p className="font-bold text-white text-sm">{a.visitante} ({a.cedula})</p>
                          <p className="text-gray-400">Destino: {a.destino} | Motivo: {a.motivo} | Vehículo: {a.vehiculo}</p>
                        </div>
                        <span className="px-2 py-1 rounded bg-emerald-500/20 text-emerald-400 font-bold">{a.estado}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {/* VISTA PAQUETES */}
            {activeTabVigilante === 'paquetes' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                <h3 className="text-md font-semibold text-white mb-4">Paquetería y Correspondencia en Portería</h3>
                <div className="space-y-2 font-mono text-xs">
                  {paquetes.map(pq => (
                    <div key={pq.id} className="flex justify-between items-center bg-[#141416] p-4 rounded-xl border border-[#262629]">
                      <div>
                        <p className="font-bold text-white text-sm">Destino: {pq.destino}</p>
                        <p className="text-gray-400">Empresa: {pq.empresa} - {pq.descripcion}</p>
                      </div>
                      <span className="px-3 py-1 rounded bg-amber-500/20 text-amber-400 font-bold">{pq.estado}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* VISTA CONTRATISTAS */}
            {activeTabVigilante === 'contratistas' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629]">
                <h3 className="text-md font-semibold text-white mb-2">Control de Contratistas y Herramientas en Puerta</h3>
                <p className="text-xs text-gray-400 mb-4">Validación automática de ARL aprobada por el Supervisor en Campo.</p>
                <div className="bg-[#141416] p-4 rounded-xl border border-[#262629] font-mono text-xs space-y-2">
                  <p className="text-emerald-400 font-bold">🟢 Ascensores Schindler S.A. - ARL Vigente</p>
                  <p className="text-gray-300">Herramientas registradas: 1 Maletín técnico, 1 Taladro percutor.</p>
                </div>
              </div>
            )}

            {/* VISTA MODO RONDA */}
            {activeTabVigilante === 'ronda' && (
              <div className="bg-[#1c1c1f] p-6 rounded-2xl border border-[#262629] space-y-4">
                <h3 className="text-md font-semibold text-white">🚀 Panel de Ronda y Puntos de Control (Checkpoints)</h3>
                <p className="text-xs text-gray-400">Selecciona el punto de control al llegar para registrar tu paso en tiempo real:</p>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {['Perímetro y Cerramiento Norte', 'Sótano 2 - Cuarto de Bombas', 'Zonas Húmedas y Piscina', 'Terrazas y Cuartos de Máquinas', 'Lobby y Pasillos de Torres'].map((cp, idx) => (
                    <div key={idx} className="bg-[#141416] p-4 rounded-xl border border-[#262629] flex justify-between items-center font-mono text-xs">
                      <div>
                        <p className="font-bold text-white">{cp}</p>
                        <p className="text-gray-400">Estado: Pendiente de Escaneo</p>
                      </div>
                      <button onClick={() => registrarCheckRonda(cp, 'Sin Novedad', 'Recorrido normal')} className="bg-emerald-500 text-black font-bold px-3 py-1.5 rounded-lg hover:bg-emerald-400">
                        📍 Registrar Check
                      </button>
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        )}

      </main>
    </div>
  );
}