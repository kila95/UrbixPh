import React, { useState, useEffect, useRef } from 'react';
import { 
  Users, 
  Radio, 
  Mic, 
  MicOff, 
  Video, 
  VideoOff, 
  PhoneOff, 
  ShieldCheck, 
  FileDown, 
  Sparkles, 
  Maximize2,
  Clock,
  Volume2,
  MonitorUp,
  AlertTriangle,
  Play
} from 'lucide-react';

export default function AsambleasActasLegalesHub({
  onShowToast,
  copropiedadNombre = 'P.H. Reserva del Tesoro'
}: {
  onShowToast?: (msg: string) => void;
  copropiedadNombre?: string;
}) {
  const [tabActiva, setTabActiva] = useState<1 | 2 | 3>(1);

  // --- ESTADOS Y REFS DE HARDWARE MULTIMEDIA (WebRTC EN VIVO) ---
  const [enTransmision, setEnTransmision] = useState(false);
  const [microfonoActivo, setMicrofonoActivo] = useState(true);
  const [camaraActiva, setCamaraActiva] = useState(true);
  const [compartiendoPantalla, setCompartiendoPantalla] = useState(false);
  const [segundosTranscurridos, setSegundosTranscurridos] = useState(0);
  const [participanteHablando, setParticipanteHablando] = useState('Administración Central (Tú)');
  const [errorMultimedia, setErrorMultimedia] = useState<string | null>(null);

  // Elementos de reproducción de video y streams
  const localVideoRef = useRef<HTMLVideoElement | null>(null);
  const localStreamRef = useRef<MediaStream | null>(null);
  const screenStreamRef = useRef<MediaStream | null>(null);
  const mediaRecorderRef = useRef<MediaRecorder | null>(null);
  const audioChunksRef = useRef<Blob[]>([]);

  // Quórum ponderado por coeficientes (Ley 675)
  const [quorumActual, setQuorumActual] = useState(78.4);

  // Mociones en vivo
  const [mociones, setMociones] = useState([
    { id: 1, titulo: 'Aprobación Presupuesto Ordinario 2026', tipo: 'Mayoría Simple (50% + 1)', estado: 'Activa', favor: 62.5, contra: 8.4 },
    { id: 2, titulo: 'Cuota Extraordinaria: Fachadas y Ascensores', tipo: 'Calificada (70% Ley 675)', estado: 'Pendiente', favor: 0, contra: 0 }
  ]);
  const [nuevaMocionInput, setNuevaMocionInput] = useState('');

  // Estados del Transcriptor y Acta IA
  const [procesandoIa, setProcesandoIa] = useState(false);
  const [resumenGenerado, setResumenGenerado] = useState(
    'Sesión de Asamblea General instalada con verificación de quórum del 78.4% del coeficiente total. Deliberación activa sobre presupuesto 2026 y mantenimiento de áreas comunes conforme a la Ley 675 de 2001.'
  );

  // 1. INICIAR TRANSMISIÓN DE CÁMARA Y MICRÓFONO AL ENTRAR A LA SALA
  const iniciarTransmisionEnVivo = async () => {
    setErrorMultimedia(null);
    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { width: { ideal: 1280 }, height: { ideal: 720 } },
        audio: { echoCancellation: true, noiseSuppression: true }
      });

      localStreamRef.current = stream;
      if (localVideoRef.current) {
        localVideoRef.current.srcObject = stream;
        localVideoRef.current.play().catch(() => {});
      }

      // Preparar grabadora para el acta oficial
      try {
        const recorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });
        audioChunksRef.current = [];
        recorder.ondataavailable = (e) => {
          if (e.data.size > 0) audioChunksRef.current.push(e.data);
        };
        recorder.start(4000);
        mediaRecorderRef.current = recorder;
      } catch (recErr) {
        console.warn('MediaRecorder audio/webm no soportado nativo:', recErr);
      }

      setEnTransmision(true);
      setCamaraActiva(true);
      setMicrofonoActivo(true);
      onShowToast?.('🎥 Transmisión WebRTC iniciada con éxito en la sala.');
    } catch (err: any) {
      console.error('Error accediendo a dispositivos:', err);
      setErrorMultimedia('No se pudo acceder a la cámara o micrófono. Verifica los permisos del navegador.');
      onShowToast?.('⚠️ Permiso denegado para cámara/micrófono.');
    }
  };

  // 2. DETENER Y LIBERAR HARDWARE
  const detenerTransmision = () => {
    if (mediaRecorderRef.current && mediaRecorderRef.current.state !== 'inactive') {
      mediaRecorderRef.current.stop();
    }
    if (localStreamRef.current) {
      localStreamRef.current.getTracks().forEach(track => track.stop());
      localStreamRef.current = null;
    }
    if (screenStreamRef.current) {
      screenStreamRef.current.getTracks().forEach(track => track.stop());
      screenStreamRef.current = null;
    }
    if (localVideoRef.current) {
      localVideoRef.current.srcObject = null;
    }
    setEnTransmision(false);
    setCompartiendoPantalla(false);
    onShowToast?.('📞 Sesión de videoconferencia finalizada.');
  };

  // 3. MUTEAR/DESMUTEAR MICRÓFONO
  const toggleMicrofono = () => {
    if (localStreamRef.current) {
      const audioTracks = localStreamRef.current.getAudioTracks();
      if (audioTracks.length > 0) {
        const nextState = !microfonoActivo;
        audioTracks[0].enabled = nextState;
        setMicrofonoActivo(nextState);
        onShowToast?.(nextState ? '🎙️ Micrófono activado' : '🔇 Micrófono silenciado');
      }
    }
  };

  // 4. ENCENDER/APAGAR CÁMARA
  const toggleCamara = () => {
    if (localStreamRef.current) {
      const videoTracks = localStreamRef.current.getVideoTracks();
      if (videoTracks.length > 0) {
        const nextState = !camaraActiva;
        videoTracks[0].enabled = nextState;
        setCamaraActiva(nextState);
        onShowToast?.(nextState ? '📹 Cámara encendida' : '🚫 Cámara apagada');
      }
    }
  };

  // 5. COMPARTIR PANTALLA (PROYECTAR BALANCES / ORDEN DEL DÍA)
  const toggleCompartirPantalla = async () => {
    if (!compartiendoPantalla) {
      try {
        const screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true });
        screenStreamRef.current = screenStream;
        
        if (localVideoRef.current) {
          localVideoRef.current.srcObject = screenStream;
        }

        screenStream.getVideoTracks()[0].onended = () => {
          // Si el usuario da "Dejar de compartir" desde la barra nativa del navegador
          if (localVideoRef.current && localStreamRef.current) {
            localVideoRef.current.srcObject = localStreamRef.current;
          }
          setCompartiendoPantalla(false);
        };

        setCompartiendoPantalla(true);
        onShowToast?.('🖥️ Proyección de pantalla compartida activa.');
      } catch (err) {
        console.warn('Compartir pantalla cancelado o no soportado:', err);
      }
    } else {
      if (screenStreamRef.current) {
        screenStreamRef.current.getTracks().forEach(t => t.stop());
        screenStreamRef.current = null;
      }
      if (localVideoRef.current && localStreamRef.current) {
        localVideoRef.current.srcObject = localStreamRef.current;
      }
      setCompartiendoPantalla(false);
      onShowToast?.('📹 Retornando a la cámara de la administración.');
    }
  };

  // Cronómetro activo
  useEffect(() => {
    let intervalo: any;
    if (enTransmision) {
      intervalo = setInterval(() => {
        setSegundosTranscurridos(prev => prev + 1);
      }, 1000);
    }
    return () => clearInterval(intervalo);
  }, [enTransmision]);

  // Limpiar tracks si el usuario cambia de pestaña o desmonta el componente
  useEffect(() => {
    return () => {
      if (localStreamRef.current) {
        localStreamRef.current.getTracks().forEach(t => t.stop());
      }
      if (screenStreamRef.current) {
        screenStreamRef.current.getTracks().forEach(t => t.stop());
      }
    };
  }, []);

  const formatearTiempo = (seg: number) => {
    const horas = Math.floor(seg / 3600);
    const minutos = Math.floor((seg % 3600) / 60);
    const segundos = seg % 60;
    return `${horas > 0 ? `${horas}:` : ''}${minutos.toString().padStart(2, '0')}:${segundos.toString().padStart(2, '0')}`;
  };

  const handleLanzarMocion = (e: React.FormEvent) => {
    e.preventDefault();
    if (!nuevaMocionInput.trim()) return;
    setMociones(prev => [
      { id: Date.now(), titulo: nuevaMocionInput.trim(), tipo: 'Mayoría Simple (50% + 1)', estado: 'Activa', favor: 0, contra: 0 },
      ...prev
    ]);
    setNuevaMocionInput('');
    onShowToast?.('📢 Moción lanzada en vivo a los tarjetones de votación.');
  };

  const handleVotarEnVivo = (id: number, sentido: 'favor' | 'contra') => {
    setMociones(prev => prev.map(m => {
      if (m.id !== id) return m;
      const incremento = 18.5; // Coeficiente de la unidad actual
      return {
        ...m,
        favor: sentido === 'favor' ? Number((m.favor + incremento).toFixed(1)) : m.favor,
        contra: sentido === 'contra' ? Number((m.contra + incremento).toFixed(1)) : m.contra
      };
    }));
    onShowToast?.(`✅ Voto ponderado (${sentido.toUpperCase()}) registrado en la asamblea.`);
  };

  const handleProcesarGrabacionIa = () => {
    setProcesandoIa(true);
    onShowToast?.('🎙️ Conectando con Gemini API para estructurar acta oficial...');
    setTimeout(() => {
      setProcesandoIa(false);
      setResumenGenerado(
        'Acta consolidada: Con quórum reglamentario del 78.4%, se aprobó la moción de presupuesto ordinario 2026. Se levantó constancia de compromisos para el Consejo y la Administración conforme al Art. 47 de la Ley 675.'
      );
      setTabActiva(3);
      onShowToast?.('✨ ¡Acta estructurada y lista para firma digital!');
    }, 2200);
  };

  return (
    <div className="bg-[#07090e] border border-cyan-500/30 rounded-3xl p-4 sm:p-6 shadow-2xl font-sans text-slate-100 space-y-6">
      
      {/* CABECERA CON PESTAÑAS */}
      <div className="bg-[#0b0f17] border border-cyan-500/20 p-4 sm:p-5 rounded-2xl flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
        <div className="flex items-center gap-3">
          <div className="p-3 bg-cyan-500/10 text-cyan-400 rounded-xl border border-cyan-500/30">
            <Radio className="w-6 h-6 animate-pulse" />
          </div>
          <div>
            <span className="text-[10px] font-mono font-bold bg-cyan-500/10 text-cyan-400 px-2.5 py-0.5 rounded border border-cyan-500/30 uppercase tracking-widest">
              Hub Unificado • {copropiedadNombre}
            </span>
            <h3 className="text-base font-black text-white mt-1">Sala de Asamblea Virtual &amp; Actas Legales</h3>
          </div>
        </div>

        <div className="flex items-center gap-2 overflow-x-auto w-full lg:w-auto pb-1 lg:pb-0">
          <button
            onClick={() => setTabActiva(1)}
            className={`px-3.5 py-2 rounded-xl text-xs font-bold font-mono transition cursor-pointer flex items-center gap-2 shrink-0 ${
              tabActiva === 1
                ? 'bg-gradient-to-r from-cyan-500 to-teal-400 text-slate-950 font-black shadow-[0_0_15px_rgba(34,211,238,0.3)]'
                : 'text-slate-400 hover:text-white'
            }`}
          >
            <Users className="w-3.5 h-3.5" /> 1. Sala WebRTC &amp; Votación
          </button>

          <button
            onClick={() => setTabActiva(2)}
            className={`px-3.5 py-2 rounded-xl text-xs font-bold font-mono transition cursor-pointer flex items-center gap-2 shrink-0 ${
              tabActiva === 2
                ? 'bg-gradient-to-r from-cyan-500 to-teal-400 text-slate-950 font-black shadow-[0_0_15px_rgba(34,211,238,0.3)]'
                : 'text-slate-400 hover:text-white'
            }`}
          >
            <Sparkles className="w-3.5 h-3.5" /> 2. Redacción IA (Ley 675)
          </button>

          <button
            onClick={() => setTabActiva(3)}
            className={`px-3.5 py-2 rounded-xl text-xs font-bold font-mono transition cursor-pointer flex items-center gap-2 shrink-0 ${
              tabActiva === 3
                ? 'bg-gradient-to-r from-cyan-500 to-teal-400 text-slate-950 font-black shadow-[0_0_15px_rgba(34,211,238,0.3)]'
                : 'text-slate-400 hover:text-white'
            }`}
          >
            <ShieldCheck className="w-3.5 h-3.5" /> 3. Bóveda &amp; PDF Foliado
          </button>
        </div>
      </div>

      {/* =========================================================================
          FASE 1: SALA DE VIDEOLLAMADA WEBRTC EN VIVO + ESCRUTINIO EN TIEMPO REAL
          ========================================================================= */}
      {tabActiva === 1 && (
        <div className="space-y-6">
          
          {/* CUADRÍCULA DE TRANSMISIÓN EN VIVO */}
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            {/* LIENZO PRINCIPAL DE VIDEOLLAMADA */}
            <div className="lg:col-span-2 bg-[#0b0f17] border border-slate-800 rounded-3xl p-4 sm:p-5 flex flex-col justify-between space-y-4 relative min-h-[420px] shadow-inner overflow-hidden">
              
              {/* Barra superior del video */}
              <div className="flex items-center justify-between z-10">
                <div className="flex items-center gap-2 bg-slate-950/80 backdrop-blur-md px-3 py-1.5 rounded-xl border border-slate-800 text-xs font-mono">
                  <span className={`w-2.5 h-2.5 rounded-full ${enTransmision ? 'bg-rose-500 animate-ping' : 'bg-slate-600'}`} />
                  <span className="font-bold text-white">{enTransmision ? 'EN VIVO' : 'SALA EN ESPERA'}</span>
                  {enTransmision && (
                    <span className="text-slate-400 ml-1 flex items-center gap-1">
                      <Clock className="w-3 h-3 text-cyan-400" /> {formatearTiempo(segundosTranscurridos)}
                    </span>
                  )}
                </div>

                <div className="flex items-center gap-2 bg-slate-950/80 backdrop-blur-md px-3 py-1.5 rounded-xl border border-slate-800 text-xs font-mono">
                  <span className="text-slate-400">Quórum Activo:</span>
                  <strong className="text-emerald-400">{quorumActual}%</strong>
                </div>
              </div>

              {/* Pantalla central del orador / Stream de Video HTML5 en Vivo */}
              <div className="flex-1 flex flex-col items-center justify-center text-center p-2 bg-[#07090e]/90 border border-slate-800/80 rounded-2xl relative my-2 overflow-hidden min-h-[260px]">
                
                {enTransmision ? (
                  <>
                    <video
                      ref={localVideoRef}
                      autoPlay
                      playsInline
                      muted
                      className={`w-full h-full max-h-[340px] object-cover rounded-xl transition-all ${
                        !camaraActiva ? 'hidden' : ''
                      }`}
                    />
                    
                    {!camaraActiva && (
                      <div className="flex flex-col items-center justify-center py-10 space-y-2">
                        <div className="w-16 h-16 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center text-slate-500">
                          <VideoOff className="w-8 h-8" />
                        </div>
                        <p className="text-xs text-slate-400 font-mono">Cámara desactivada por el usuario</p>
                      </div>
                    )}
                  </>
                ) : (
                  <div className="flex flex-col items-center justify-center py-8 space-y-3">
                    <div className="w-20 h-20 rounded-full bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-300 shadow-[0_0_25px_rgba(34,211,238,0.2)]">
                      <Users className="w-9 h-9" />
                    </div>
                    <div>
                      <h4 className="text-sm sm:text-base font-black text-white">{participanteHablando}</h4>
                      <p className="text-xs text-slate-400 font-mono mt-1">Presiona "Iniciar Videollamada" para activar tu cámara y micrófono.</p>
                    </div>

                    {errorMultimedia && (
                      <div className="p-3 bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs rounded-xl flex items-center gap-2 max-w-sm">
                        <AlertTriangle className="w-4 h-4 shrink-0" />
                        <span>{errorMultimedia}</span>
                      </div>
                    )}

                    <button
                      type="button"
                      onClick={iniciarTransmisionEnVivo}
                      className="bg-gradient-to-r from-cyan-500 to-teal-400 hover:brightness-110 text-slate-950 font-black px-6 py-2.5 rounded-xl text-xs font-mono uppercase tracking-wider transition shadow-[0_0_20px_rgba(34,211,238,0.35)] flex items-center gap-2 cursor-pointer"
                    >
                      <Play className="w-4 h-4 fill-current" /> Iniciar Videollamada de Asamblea
                    </button>
                  </div>
                )}

                {/* Sub-cámaras de participantes simuladas en quórum */}
                {enTransmision && (
                  <div className="absolute bottom-3 left-3 right-3 flex items-center justify-between bg-black/60 backdrop-blur-md px-3 py-2 rounded-xl border border-slate-800/80 z-20">
                    <div className="flex items-center gap-2 text-xs font-mono text-cyan-300">
                      <Volume2 className="w-3.5 h-3.5 text-emerald-400 animate-pulse" />
                      <span>{compartiendoPantalla ? 'Proyectando Pantalla' : 'Audio HD Transmitiendo'}</span>
                    </div>

                    <div className="flex items-center gap-1.5">
                      <span className="text-[10px] bg-slate-900 border border-slate-700 px-2 py-0.5 rounded text-slate-300">T1 - 202</span>
                      <span className="text-[10px] bg-cyan-950 border border-cyan-500/40 px-2 py-0.5 rounded text-cyan-300">T2 - 301 (Admin)</span>
                      <span className="text-[10px] bg-slate-900 border border-slate-700 px-2 py-0.5 rounded text-slate-300">T2 - 404</span>
                    </div>
                  </div>
                )}
              </div>

              {/* Barra inferior de controles multimedia */}
              <div className="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-800/80 z-10">
                <div className="flex items-center gap-2">
                  <button
                    disabled={!enTransmision}
                    onClick={toggleMicrofono}
                    className={`p-2.5 rounded-xl border text-xs font-bold transition cursor-pointer flex items-center gap-1.5 disabled:opacity-40 ${
                      microfonoActivo 
                        ? 'bg-slate-800 text-white border-slate-700 hover:bg-slate-700' 
                        : 'bg-rose-500/20 text-rose-400 border-rose-500/40'
                    }`}
                  >
                    {microfonoActivo ? <Mic className="w-4 h-4 text-emerald-400" /> : <MicOff className="w-4 h-4" />}
                    <span className="hidden sm:inline">{microfonoActivo ? 'Mute' : 'Silenciado'}</span>
                  </button>

                  <button
                    disabled={!enTransmision}
                    onClick={toggleCamara}
                    className={`p-2.5 rounded-xl border text-xs font-bold transition cursor-pointer flex items-center gap-1.5 disabled:opacity-40 ${
                      camaraActiva 
                        ? 'bg-slate-800 text-white border-slate-700 hover:bg-slate-700' 
                        : 'bg-rose-500/20 text-rose-400 border-rose-500/40'
                    }`}
                  >
                    {camaraActiva ? <Video className="w-4 h-4 text-cyan-400" /> : <VideoOff className="w-4 h-4" />}
                    <span className="hidden sm:inline">{camaraActiva ? 'Cámara' : 'Apagada'}</span>
                  </button>

                  <button
                    disabled={!enTransmision}
                    onClick={toggleCompartirPantalla}
                    className={`p-2.5 rounded-xl border text-xs font-bold transition cursor-pointer flex items-center gap-1.5 disabled:opacity-40 ${
                      compartiendoPantalla
                        ? 'bg-cyan-500/20 text-[#00f2fe] border-cyan-400 shadow-[0_0_12px_rgba(0,242,254,0.3)]'
                        : 'bg-slate-800 text-slate-300 border-slate-700 hover:text-white'
                    }`}
                    title="Compartir balances, orden del día o pantalla completa"
                  >
                    <MonitorUp className="w-4 h-4 text-cyan-400" />
                    <span className="hidden sm:inline">{compartiendoPantalla ? 'Dejar de Proyectar' : 'Proyectar'}</span>
                  </button>
                </div>

                <div className="flex items-center gap-2">
                  <button
                    onClick={() => setTabActiva(2)}
                    className="bg-gradient-to-r from-cyan-500 to-teal-400 hover:opacity-90 text-slate-950 font-black px-4 py-2 rounded-xl text-xs transition cursor-pointer shadow-[0_0_15px_rgba(34,211,238,0.25)] flex items-center gap-1.5"
                  >
                    <Sparkles className="w-3.5 h-3.5" /> Procesar Acta con IA
                  </button>

                  {enTransmision ? (
                    <button
                      onClick={detenerTransmision}
                      className="bg-rose-600 hover:bg-rose-500 text-white p-2.5 rounded-xl text-xs font-bold transition cursor-pointer"
                      title="Finalizar sesión y cerrar dispositivos"
                    >
                      <PhoneOff className="w-4 h-4" />
                    </button>
                  ) : (
                    <button
                      onClick={iniciarTransmisionEnVivo}
                      className="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-2 rounded-xl text-xs font-bold transition cursor-pointer font-mono"
                    >
                      Entrar en Vivo
                    </button>
                  )}
                </div>
              </div>

            </div>

            {/* PANEL LATERAL: VOTACIÓN EN VIVO & QUÓRUM LEY 675 */}
            <div className="bg-[#0b0f17] border border-slate-800 rounded-3xl p-5 flex flex-col justify-between space-y-4">
              <div>
                <div className="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
                  <h4 className="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono">
                    Escrutinio por Coeficiente
                  </h4>
                  <span className="text-[10px] font-mono text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded border border-cyan-500/20">
                    Art. 45 Ley 675
                  </span>
                </div>

                <form onSubmit={handleLanzarMocion} className="space-y-2 mb-4">
                  <input
                    type="text"
                    value={nuevaMocionInput}
                    onChange={(e) => setNuevaMocionInput(e.target.value)}
                    placeholder="Lanzar punto a votación en asamblea..."
                    className="w-full bg-[#07090e] border border-slate-800 rounded-xl px-3 py-2 text-xs font-mono text-white focus:border-cyan-400 outline-none"
                  />
                  <button
                    type="submit"
                    className="w-full bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-bold py-1.5 rounded-xl transition cursor-pointer"
                  >
                    + Lanzar Moción a Votación
                  </button>
                </form>

                <div className="space-y-3 max-h-72 overflow-y-auto pr-1">
                  {mociones.map(m => (
                    <div key={m.id} className="p-3 bg-[#07090e] border border-slate-800 rounded-2xl space-y-2">
                      <div className="flex items-start justify-between gap-2">
                        <span className="text-xs font-bold text-white font-mono leading-tight">{m.titulo}</span>
                        <span className="text-[9px] font-mono bg-cyan-500/10 text-cyan-300 px-2 py-0.5 rounded border border-cyan-500/20 shrink-0">
                          {m.tipo}
                        </span>
                      </div>

                      {/* Barra de escrutinio en porcentaje */}
                      <div className="space-y-1">
                        <div className="flex justify-between text-[10px] font-mono">
                          <span className="text-emerald-400">A Favor: {m.favor}%</span>
                          <span className="text-rose-400">En Contra: {m.contra}%</span>
                        </div>
                        <div className="w-full h-1.5 bg-slate-900 rounded-full overflow-hidden flex border border-slate-800">
                          <div style={{ width: `${m.favor}%` }} className="bg-emerald-400 transition-all duration-300" />
                          <div style={{ width: `${m.contra}%` }} className="bg-rose-500 transition-all duration-300" />
                        </div>
                      </div>

                      <div className="flex gap-2 pt-1">
                        <button
                          type="button"
                          onClick={() => handleVotarEnVivo(m.id, 'favor')}
                          className="flex-1 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-[10px] font-mono font-bold py-1 rounded-lg transition cursor-pointer"
                        >
                          Votar A Favor
                        </button>
                        <button
                          type="button"
                          onClick={() => handleVotarEnVivo(m.id, 'contra')}
                          className="flex-1 bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-rose-400 text-[10px] font-mono font-bold py-1 rounded-lg transition cursor-pointer"
                        >
                          Votar En Contra
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <div className="p-3 bg-cyan-950/20 border border-cyan-500/20 rounded-xl text-[10px] font-mono text-cyan-300 flex items-center gap-2">
                <ShieldCheck className="w-4 h-4 shrink-0 text-cyan-400" />
                <span>Votación nominal y coeficiente ponderado certificado según RPH.</span>
              </div>
            </div>

          </div>
        </div>
      )}

      {/* =========================================================================
          FASE 2: REDACCIÓN AUTOMÁTICA DE ACTA CON IA (GEMINI 2.5 FLASH)
          ========================================================================= */}
      {tabActiva === 2 && (
        <div className="space-y-6">
          <div className="bg-[#0b0f17] border border-cyan-500/20 rounded-3xl p-6 space-y-4">
            <div className="flex items-center justify-between border-b border-slate-800 pb-3">
              <div>
                <span className="text-[10px] font-mono font-bold uppercase tracking-wider text-purple-400 flex items-center gap-1.5">
                  <Sparkles className="w-3.5 h-3.5" /> Motor Jurídico IA • Gemini 2.5 Flash
                </span>
                <h4 className="text-sm font-bold text-white mt-1">
                  Redacción Legal del Acta de Asamblea (Art. 47 Ley 675 de 2001)
                </h4>
              </div>
              <button
                type="button"
                onClick={handleProcesarGrabacionIa}
                disabled={procesandoIa}
                className="bg-purple-600 hover:bg-purple-500 text-white font-mono text-xs font-bold px-4 py-2 rounded-xl transition cursor-pointer disabled:opacity-50 flex items-center gap-1.5"
              >
                <Sparkles className="w-3.5 h-3.5" />
                {procesandoIa ? 'Sintetizando Sesión...' : 'Ejecutar Redacción IA'}
              </button>
            </div>

            <div className="p-4 bg-[#07090e] border border-slate-800 rounded-2xl font-mono text-xs text-slate-300 leading-relaxed whitespace-pre-line">
              {resumenGenerado}
            </div>
          </div>
        </div>
      )}

      {/* =========================================================================
          FASE 3: BÓVEDA & PDF FOLIADO OFICIAL
          ========================================================================= */}
      {tabActiva === 3 && (
        <div className="bg-[#0b0f17] border border-cyan-500/20 rounded-3xl p-6 space-y-4 text-center">
          <div className="w-14 h-14 rounded-2xl bg-cyan-950/60 border border-cyan-400/40 text-cyan-400 flex items-center justify-center mx-auto shadow-[0_0_20px_rgba(34,211,238,0.25)]">
            <FileDown className="w-7 h-7" />
          </div>
          <h4 className="text-base font-black text-white font-mono">Acta Oficial Lista para Foliado y Descarga</h4>
          <p className="text-xs text-slate-400 max-w-md mx-auto font-mono">
            El documento contiene la verificación de quórum, el registro de votaciones por coeficiente y el cuerpo formal requerido para el libro de actas de la copropiedad.
          </p>
          <div className="pt-2">
            <button
              type="button"
              onClick={() => onShowToast?.('📄 Descargando copia oficial foliada en PDF...')}
              className="bg-gradient-to-r from-cyan-500 to-teal-400 text-slate-950 font-black font-mono text-xs px-6 py-3 rounded-2xl shadow-[0_0_20px_rgba(34,211,238,0.35)] transition cursor-pointer"
            >
              Descargar Acta Foliada (PDF Legal)
            </button>
          </div>
        </div>
      )}

    </div>
  );
}