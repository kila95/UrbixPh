            </thead>
            <tbody>
              {users.map(u => (
                <tr key={u.id} style={{ borderBottom: '1px solid #262629' }}>
                  <td style={{ padding: '12px' }}>
                    <div style={{ fontWeight: '500', color: '#fff' }}>{u.name}</div>
                    <div style={{ fontSize: '12px', color: '#94a3b8', fontFamily: 'monospace' }}>{u.email}</div>
                  </td>
                  <td style={{ padding: '12px' }}>
