      {activeTab === 'finance' && (
        <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
          <h3 style={{ margin: '0 0 8px 0', fontSize: '16px', color: '#ffffff' }}>Consolidado Financiero y Tesorería (P&L Global)</h3>
          <p style={{ fontSize: '13px', color: '#94a3b8', margin: '0 0 20px 0' }}>Flujo de caja consolidado de la firma administradora y pasarelas de pago.</p>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '16px', marginBottom: '24px' }}>
            <div style={{ backgroundColor: '#1c1c1f', padding: '16px', borderRadius: '8px', border: '1px solid #262629' }}>
