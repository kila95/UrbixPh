            </div>
          </div>

          <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
            <h3 style={{ margin: '0 0 16px 0', fontSize: '16px', color: '#ffffff' }}>Túneles Remotos y Canales de Mantenimiento</h3>
            <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: '14px' }}>
              <thead>
                <tr style={{ backgroundColor: '#1c1c1f', color: '#94a3b8', fontFamily: 'monospace', fontSize: '12px' }}>
                  <th style={{ padding: '12px' }}>Servicio</th>
                  <th style={{ padding: '12px' }}>Protocolo</th>
                  <th style={{ padding: '12px' }}>Estado</th>
                  <th style={{ padding: '12px', textAlign: 'right' }}>Control Remoto</th>
                </tr>
              </thead>
              <tbody>
                {tunnels.map(t => (
                  <tr key={t.id} style={{ borderBottom: '1px solid #262629' }}>
                    <td style={{ padding: '12px', fontWeight: '500', color: '#fff' }}>{t.name}</td>
                    <td style={{ padding: '12px', color: '#94a3b8', fontFamily: 'monospace', fontSize: '12px' }}>{t.type}</td>
                    <td style={{ padding: '12px' }}>
                      <span style={{ padding: '2px 6px', borderRadius: '4px', fontSize: '11px', fontFamily: 'monospace', fontWeight: 'bold', backgroundColor: 'rgba(16, 185, 129, 0.1)', color: '#34d399' }}>
                        {t.status}
                      </span>
                    </td>
                    <td style={{ padding: '12px', textAlign: 'right' }}>
                      <button 
                        onClick={() => toggleTunnel(t.id)}
                        style={{ backgroundColor: '#1c1c1f', border: '1px solid #262629', color: '#f43f5e', padding: '4px 8px', borderRadius: '4px', fontSize: '11px', fontFamily: 'monospace', cursor: 'pointer' }}
                      >
                        {t.status === 'Activo' ? 'Desconectar' : 'Conectar'}
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

    </div>
  );
}