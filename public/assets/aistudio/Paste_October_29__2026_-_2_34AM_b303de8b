                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* ================= 2. CONTROL DE ROLES (RBAC) ================= */}
      {activeTab === 'rbac' && (
        <div style={{ backgroundColor: '#141416', border: '1px solid #262629', borderRadius: '12px', padding: '24px' }}>
          <h3 style={{ margin: '0 0 8px 0', fontSize: '16px', color: '#ffffff' }}>Control Jerárquico de Permisos (RBAC)</h3>
